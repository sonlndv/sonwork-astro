{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonwork",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-20",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Static files are served without waking the Worker. Only the API needs it.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create COMMENTS
    // then paste the id it prints here. Local dev works with the placeholder.
    { "binding": "COMMENTS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    // Only these identities may write notes. Cloudflare Access supplies the
    // email; anyone else gets 403. Comma-separated.
    "ALLOWED_EMAILS": "son@perfeat.org,tuanson.le03@gmail.com"
  }
}
