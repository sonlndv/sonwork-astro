{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonwork",
  "main": "src/worker/index.mjs",
  "compatibility_date": "2026-05-20",
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "sonwork.org/*",
      "zone_name": "sonwork.org"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/book",
      "/book/",
      "/book/status",
      "/book/status/",
      "/404",
      "/404/",
      "/404.html"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "COMMENTS",
      "id": "b6fc8a4385bf42e9a559f12a795b34d6"
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
