{
  "name": "sonwork",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "node scripts/assert-release-env.mjs && SHOW_DRAFTS=true astro build",
    "preview": "astro preview",
    "check": "node scripts/assert-release-env.mjs && astro check && npm run build",
    "test": "npm run test:unit && npm run build:preview && npm run test:redirects && npm run test:links && npm run test:e2e && npm run test:lh",
    "test:redirects": "node scripts/check-redirect-map.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "test:lh": "lhci autorun",
    "astro": "astro",
    "prebuild": "node scripts/assert-release-env.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "test:production": "node scripts/test-worker.mjs --from-preview --browser",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "linkinator": "^8.1.0",
    "playwright-core": "1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  }
}
