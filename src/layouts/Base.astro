---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Mark from '../components/Mark.astro';
interface Props {
  title: string; description?: string; current?: string;
  lang?: 'en' | 'vi'; indexable?: boolean;
}
const { title, description, current, lang = 'en', indexable = true } = Astro.props;
const nav = [
  { href: '/readings/', label: 'Readings', key: 'readings' },
  { href: '/projects/', label: 'Projects', key: 'projects' },
  { href: '/about/',   label: 'About',    key: 'about' },
];
---
<!doctype html>
<html lang={lang} style="background:#0b1524">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <link rel="alternate" type="application/rss+xml" title="What Sonar found" href="/rss.xml" />
  {description && <meta name="description" content={description} />}
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:image" content="https://sonwork.org/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#101a2b" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
  <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Saira+Condensed:wght@800;900&display=swap" />
  <script is:inline>
    // Apply the stored theme before first paint. No flash.
    try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
  </script>
  <ClientRouter />
</head>
<body style="background:#0b1524">
  <div class="sea" aria-hidden="true"><span class="lb lb1"></span></div>
  <header class="w">
    <div class="bar">
      <a class="me" href="/" aria-label="Home"><Mark size={24} label={false} /></a>
      <nav>
        {nav.map(n => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
        {(
          <button class="sbtn" type="button" id="open-search" aria-label="Search (⌘K)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
            <span>Search</span><kbd>⌘K</kbd>
          </button>
        )}
        <button class="tbtn" type="button" id="theme" aria-label="Switch light or dark theme" title="Theme">
          <svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main class="w"><slot /></main>

  <footer class="w">
    <span>Lê Sơn · Vietnam</span>
    <a href="/about/" style="margin-left:auto">About</a>
    <a href="https://www.linkedin.com/in/sonle2003">LinkedIn</a>
    <a href="https://x.com/sonldv">X</a>
  </footer>

  {(
    <dialog id="search" aria-label="Search">
      <div class="sbox"><div id="pagefind"></div><p class="shint">Esc to close · searches every report and post, in both languages</p></div>
    </dialog>
  )}

  <script>
    // Everything here re-binds on every client-side navigation.
    function boot() {
      // entrance: each element marks itself in; if animations never run, force everything in
      const appear = document.querySelectorAll<HTMLElement>('.appear');
      appear.forEach((el) => el.addEventListener('animationend', () => el.classList.add('is-in'), { once: true }));
      requestAnimationFrame(() => requestAnimationFrame(() => {
        const running = [...appear].some((el) => (el.getAnimations?.() || []).some((a) => a.playState === 'running' || a.playState === 'finished'));
        if (!running) appear.forEach((el) => el.classList.add('is-in'));
      }));

      // the shortcut hint should name the key the visitor actually has
      if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('kbd').forEach(k => { if (k.textContent === '⌘K') k.textContent = 'Ctrl K'; });
      // theme
      const tb = document.getElementById('theme');
      tb?.addEventListener('click', () => {
        const root = document.documentElement;
        const sysLight = matchMedia('(prefers-color-scheme: light)').matches;
        const cur = root.dataset.theme || (sysLight ? 'light' : 'dark');
        const next = cur === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // search
      const dlg = document.getElementById('search') as HTMLDialogElement | null;
      const btn = document.getElementById('open-search');
      const w = window as any;
      async function openSearch() {
        if (!dlg) return;
        if (!w.__pfLoaded) {
          w.__pfLoaded = true;
          const css = document.createElement('link'); css.rel = 'stylesheet'; css.href = '/pagefind/pagefind-ui.css'; document.head.appendChild(css);
          await new Promise<void>((res) => { const s = document.createElement('script'); s.src = '/pagefind/pagefind-ui.js'; s.onload = () => res(); s.onerror = () => res(); document.head.appendChild(s); });
        }
        const host = document.getElementById('pagefind')!;
        if (!host.dataset.ready) {
          host.dataset.ready = '1';
          if (w.PagefindUI) new w.PagefindUI({ element: '#pagefind', showSubResults: true, showImages: false, excerptLength: 26, translations: { placeholder: 'Search…', zero_results: 'Nothing for [SEARCH_TERM]' } });
          else host.innerHTML = '<p class="shint">Search index is built at deploy time; not available in this preview.</p>';
        }
        dlg.showModal();
        (dlg.querySelector('input') as HTMLInputElement | null)?.focus();
      }
      btn?.addEventListener('click', openSearch);
      dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      if (!w.__keys) { w.__keys = true; document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); const d = document.getElementById('search') as HTMLDialogElement | null; d?.open ? d.close() : openSearch(); }
      }); }

      // tilt: panels lean toward the pointer (fine pointers only)
      if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('.tilt').forEach((el) => {
          el.addEventListener('pointermove', (e) => { const r = el.getBoundingClientRect(); const x = (e.clientX - r.left) / r.width - .5; const y = (e.clientY - r.top) / r.height - .5; el.style.setProperty('--ry', (x * 6) + 'deg'); el.style.setProperty('--rx', (-y * 6) + 'deg'); });
          el.addEventListener('pointerleave', () => { el.style.setProperty('--rx', '0deg'); el.style.setProperty('--ry', '0deg'); });
        });
      }

      // live counters: numbers count up once, to their real value
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const target = Number(el.dataset.count); if (!Number.isFinite(target)) return;
          const t0 = performance.now(); const dur = 900;
          const tick = (t: number) => { const k = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - k, 4); el.textContent = String(Math.round(target * e)); if (k < 1) requestAnimationFrame(tick); };
          requestAnimationFrame(tick);
        });
      }
    }
    document.addEventListener('astro:page-load', boot);
  </script>
</body>
</html>
