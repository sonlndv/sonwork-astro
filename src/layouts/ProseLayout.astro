---
import BaseLayout from './BaseLayout.astro';
import DraftLabel from '../components/DraftLabel.astro';

interface Props {
  title: string;
  description: string;
  draft?: boolean;
  type?: 'website' | 'article';
}

const { title, description, draft = false, type = 'article' } = Astro.props;
---
<BaseLayout title={title} description={description} type={type}>
  <article class="prose-page">
    <header class="prose-header">
      <h1>{title}</h1>
      {draft && <p class="meta"><DraftLabel /></p>}
      <slot name="meta" />
    </header>
    <div class="prose-body">
      <div class="prose">
        <slot />
      </div>
      <slot name="end" />
    </div>
  </article>
</BaseLayout>
