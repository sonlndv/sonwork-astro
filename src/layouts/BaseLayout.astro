---
import fontsCss from '../styles/fonts.css?inline';
import globalCss from '../styles/global.css?inline';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import SonBrand from '../components/SonBrand.astro';
interface Props { title: string; description: string; type?: 'website' | 'article'; noIndex?: boolean; }
const { title, description, type = 'website', noIndex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site);
const robotsOff = noIndex;
const nav = [
  { href: '/', label: 'About Me', labelVi: 'Giới thiệu' },
  { href: '/series', label: 'Series', labelVi: 'Series' },
  { href: '/study', label: 'Study', labelVi: 'Học tập' },
  { href: '/hobbies', label: 'Hobbies', labelVi: 'Sở thích' },
  { href: 'mailto:son@sonwork.org', label: 'Contact', labelVi: 'Liên hệ' },
];
const current = (href: string) => href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
const speculationRules = JSON.stringify({ prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title === 'Son.' ? title : `${title} | Son.`}</title>
    <meta name="description" content={description} />
    {robotsOff && <meta name="robots" content="noindex, follow" />}
    {!noIndex && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Son. notes" href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Son." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg?v=son-ridge-1" type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#02050d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafd" media="(prefers-color-scheme: light)" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
        const lang = localStorage.getItem('lang');
        if (lang === 'vi') document.documentElement.dataset.lang = 'vi';
      } catch { /* Storage denial keeps the complete English-interface fallback. */ }
      document.documentElement.classList.add('js');
    </script>
    <link rel="preload" href="/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={[fontsCss, globalCss].join('\n')}></style>
    <script type="speculationrules" is:inline set:html={speculationRules}></script>
  </head>
  <body class:list={{ 'home-sections': path === '/' }}>
    <a class="skip-link" href="#main"><span class="i18n-en">Skip to content</span><span class="i18n-vi" lang="vi">Bỏ qua, đến nội dung chính</span></a>
    <header class="site-header">
      <div class="frame header-bar">
        <a class="wordmark" href="/" aria-label="Son. — About Me"><SonBrand /></a>
        <nav class="site-nav" aria-label="Main">
          <ul>{nav.map(item => <li><a href={item.href} aria-current={current(item.href) ? 'page' : undefined}><span class="i18n-en">{item.label}</span><span class="i18n-vi" lang="vi">{item.labelVi}</span></a></li>)}</ul>
        </nav>
        <div class="header-controls">
          <ThemeToggle />
          <LanguageToggle />
        </div>
      </div>
    </header>
    <main id="main" class="frame" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="frame footer-inner">
        <p><span class="i18n-en">Son. / notes on learning with agents</span><span class="i18n-vi" lang="vi">Son. / ghi chú về học cùng các trợ lý AI</span></p>
        <nav aria-label="Archive and contact">
          <a href="/series"><span class="i18n-en">All series</span><span class="i18n-vi" lang="vi">Tất cả series</span></a><a href="/work"><span class="i18n-en">Build archive</span><span class="i18n-vi" lang="vi">Kho dự án</span></a><a href="mailto:son@sonwork.org"><span class="i18n-en">Contact</span><span class="i18n-vi" lang="vi">Liên hệ</span></a><a href="/rss.xml">RSS</a>
        </nav>
        <nav aria-label="Pages in progress">
          <a href="/project" aria-current={current('/project') ? 'page' : undefined}><span class="i18n-en">Project (coming soon)</span><span class="i18n-vi" lang="vi">Dự án (sắp ra mắt)</span></a>
        </nav>
      </div>
    </footer>
  </body>
</html>
