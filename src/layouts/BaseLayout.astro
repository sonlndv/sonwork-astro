---
import homeSceneCss from '../styles/home-scene.css?inline';
import fontsCss from '../styles/fonts.css?inline';
import globalCss from '../styles/global.css?inline';
import companionCss from '../styles/companion.css?inline';
// BUILD-ONLY asset mechanism: `?worker&url` asks Vite to compile the unchanged public landscape script into a minified classic
// (IIFE) asset and return its hashed URL. No Web Worker is ever created or instantiated; EVERY route loads that URL through the
// same ordinary classic deferred <script> element below. All routes carry the generic data-landscape-runtime marker; the
// Home-only data-home-runtime marker keeps its meaning and stays absent off Home. The public /mountains/mountains.js file itself
// is unchanged and still served, it is just no longer referenced by any page.
import homeLandscapeUrl from '../../public/mountains/mountains.js?worker&url';
import ThemeToggle from '../components/ThemeToggle.astro';
import MountCompanion from '../components/MountCompanion.astro';
import MountainScene from '../components/MountainScene.astro';
import { signupOpen } from '../lib/signup';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
}

// Keep the shared cascade inline: measured cold first paint regressed with a separate stylesheet.
const isHome = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/(.)\/$/, '$1') === '/';
const sharedCss = [homeSceneCss, fontsCss, globalCss, companionCss].join('\n');

const { title, description, type = 'website', noIndex = false } = Astro.props;
const siteName = 'Son';
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site);
// Shared world: every route carries the same mist ground, header scrim and browser-chrome tone.
const lightTone = '#dfe4ea';

// Home is the wordmark; the strip holds the four sections. Subscribe carries the accent only while signup is open.
const nav = [
  { href: '/work', label: 'Build', accent: false },
  { href: '/writing', label: 'Writing', accent: false },
  { href: '/about', label: 'About', accent: false },
  { href: '/subscribe', label: 'Subscribe', accent: signupOpen },
];

// Same-site prefetch (speculation rules): Chromium starts loading a page when the pointer rests on its link or on press.
// Other browsers ignore it. It matches only this site's paths and runs no script.
const speculationRules = JSON.stringify({ prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] });

const contact = [
  { href: 'mailto:son@sonwork.org', label: 'Email' },
  { href: 'https://x.com/sonldv', label: 'X' },
  { href: 'https://github.com/sonlndv', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/sonle2003', label: 'LinkedIn' },
  { href: '/rss.xml', label: 'RSS' },
];

function isCurrent(href: string): boolean {
  return path === href || path.startsWith(`${href}/`);
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} writing`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg?v=mount-1" type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#04070e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={lightTone} media="(prefers-color-scheme: light)" />
    <!-- Apply the stored theme before first paint, so there is no flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      document.documentElement.classList.add('js');
      // Keep the browser theme colour in step with a stored/manual theme. Browser chrome only gets a
      // flat colour (the header scrim's own tone); with no manual choice the media-matched metas rule.
      (() => {
        const root = document.documentElement;
        const metas = Array.from(document.querySelectorAll('meta[name="theme-color"]'));
        metas.forEach((meta) => { meta.dataset.system = meta.content; });
        const lightMeta = metas.find((meta) => meta.media.includes('light'));
        const tones = { dark: '#04070e', light: lightMeta ? lightMeta.dataset.system : '#cddff1' };
        const sync = () => {
          const t = root.dataset.theme;
          metas.forEach((meta) => { meta.content = t === 'light' || t === 'dark' ? tones[t] : meta.dataset.system; });
        };
        sync();
        new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      })();
    </script>
    <!-- Two faces above the fold: display/label mono and prose sans. -->
    <!-- Regular mono also sets visible nav geometry; fetch before first paint. -->
    <link rel="preload" href="/fonts/space-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {type === 'article' && <link rel="preload" href="/fonts/geist-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />}
    <style is:inline set:html={sharedCss}></style>
    <!-- Mount: native button, focus, touch and motion behaviour. -->
    <script is:inline src="/companion.js" defer></script>
    <!-- One shared scene. Defer order: native Mount producer, landscape frame, atmosphere eligibility. -->
    {isHome
      ? <script is:inline src={homeLandscapeUrl} defer data-landscape-runtime="mountains" data-home-runtime="mountains"></script>
      : <script is:inline src={homeLandscapeUrl} defer data-landscape-runtime="mountains"></script>}
    <!-- Atmosphere connects the arrival mist and hello policy; there is no Pause control, and finite effects never schedule idle recurrence. -->
    <script is:inline src="/atmosphere.js" defer></script>
    <script type="speculationrules" is:inline set:html={speculationRules}></script>
  </head>
  <body class="mountains home-study">
    <MountainScene />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <nav class="site-nav" aria-label="Main">
          <div class="personal-brand">
            <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>Son</a>
            <MountCompanion />
          </div>
          <ul>
            {nav.map((item) => (
              <li class={item.accent ? 'nav-accent' : undefined}>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" data-valley-landmark="footer">
      <div class="frame">
        <div class="footer-seat"><span class="footer-slot" aria-hidden="true"></span><button class="footer-top" id="companion-return" type="button" hidden>Back to top</button></div>
        <p class="footer-name"><span>Son</span><span>sonwork.org</span></p>
        <ul class="contact-links">
          {contact.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    </footer>
    <script>
      // Rows remain visible until an intersecting row earns a one-shot arrival.
      const preference = matchMedia('(prefers-reduced-motion: no-preference)');
      const rows = document.querySelectorAll<HTMLElement>('.row, .side-project');
      let observer: IntersectionObserver | undefined;
      if (preference.matches && 'IntersectionObserver' in window) {
        observer = new IntersectionObserver(entries => {
          let order = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const row = entry.target as HTMLElement;
            row.style.setProperty('--arrival-delay', `${Math.min(order++ * 40, 120)}ms`);
            row.dataset.motionArrive = '';
            observer!.unobserve(row);
          }
        }, { threshold: 0.08 });
        rows.forEach(row => observer!.observe(row));
      }
      preference.addEventListener('change', () => {
        observer?.disconnect();
        rows.forEach(row => delete row.dataset.motionArrive);
      });
    </script>
  </body>
</html>
