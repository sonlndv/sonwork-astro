---
// Nav = Work · Writing · About. Brand logo links home.
interface Props {
  active: 'dashboard' | 'writing' | 'projects' | 'about';
}
const { active } = Astro.props;

const links: { href: string; label: string; id: Props['active'] }[] = [
  { href: '/projects', label: 'Work', id: 'projects' },
  { href: '/writing', label: 'Writing', id: 'writing' },
  { href: '/about', label: 'About', id: 'about' },
];
---
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="Sơn — sonwork home">
      <span class="nav-brand-name">Sơn</span>
      <span class="nav-brand-sub">Sonwork</span>
    </a>
    <div class="nav-right">
      <div class="nav-links">
        {links.map(link => (
          <a href={link.href} class:list={['nav-link', { active: link.id === active }]}>{link.label}</a>
        ))}
      </div>
      <a href="https://perfeat.org" target="_blank" rel="noopener" class="nav-pill">Perfeat ↗</a>
    </div>
  </div>
</nav>
