---
// LS15 — Sơn's mark. Condensed, skewed like a driver number: LS in ink, 15 in
// the accent. Built from type so it is crisp at every size; Saira Condensed is
// loaded for the mark only and appears nowhere else on the site.
interface Props { size?: number; class?: string; label?: boolean }
const { size = 22, class: cls = '', label = true } = Astro.props;
---
<span class:list={['ls15', cls]} style={`--s:${size}px`} aria-label={label ? 'LS15, Son Lê' : undefined} role={label ? 'img' : undefined}>
  <b>LS</b><i>15</i>
</span>
