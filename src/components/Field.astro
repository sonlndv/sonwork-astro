---
// The archive, drawn. One node per reading: x by date, y by theme, size by
// revision, a hairline from each reading to the previous one by the same
// agent. Server-rendered SVG; hover and motion are CSS, so it is complete
// without JavaScript. The readings index dims nodes that fall outside the
// active filters and lights a node when its row is hovered, and the reverse.
import type { CollectionEntry } from 'astro:content';
import { glyph, THEME_LABEL } from '../lib/glyphs';
import { THEMES } from '../content.config';
interface Props { reports: CollectionEntry<'reports'>[] }
const { reports } = Astro.props;
const kinds = [...THEMES];
const W = 1000, H = 300, PAD = 60;
const times = reports.map(r => r.data.date.getTime());
const t0 = Math.min(...times, Date.now() - 30 * 864e5), t1 = Math.max(...times, Date.now());
const x = (t: number) => PAD + ((t - t0) / Math.max(1, t1 - t0)) * (W - PAD * 2);
const y = (k: string) => 34 + kinds.indexOf(k) * ((H - 68) / (kinds.length - 1));
const sorted = [...reports].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const nodes = sorted.map((r, i) => ({
  id: r.id, title: r.data.title, author: r.data.author, kind: r.data.type, lang: r.data.lang,
  cx: x(r.data.date.getTime()), cy: y(r.data.type), r: 4 + Math.min(4, r.data.revision), i,
}));
// one link per node, back to the previous reading by the same agent: n lines, not n²
const lastBy = new Map<string, typeof nodes[0]>();
const links: [typeof nodes[0], typeof nodes[0]][] = [];
for (const n of nodes) { const p = lastBy.get(n.author); if (p) links.push([p, n]); lastBy.set(n.author, n); }
const iso = (t: number) => new Date(t).toISOString().slice(0, 10).replace(/-/g, '.');
---
<figure class="field" aria-label="The archive as a map: readings by date and theme">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" class="field-bg" aria-hidden="true">
    {kinds.map(k => <line x1={PAD - 20} x2={W - PAD + 20} y1={y(k)} y2={y(k)} />)}
  </svg>
  <div class="field-labels" aria-hidden="true">
    {kinds.map(k => <span style={`top:${(y(k) / H) * 100}%`} set:html={glyph(k, 12) + `<i>${THEME_LABEL[k]}</i>`} />)}
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} class="field-fg">
    {links.map(([a, b]) => <line class="link" data-a={a.i} data-b={b.i} x1={a.cx} y1={a.cy} x2={b.cx} y2={b.cy} />)}
    {nodes.map(n => (
      <a href={`/readings/${n.id}/`} class="node" data-id={n.id} data-i={n.i} data-type={n.kind} data-lang={n.lang} style={`--d:${(n.i * 137) % 900}ms`}>
        <circle cx={n.cx} cy={n.cy} r={n.r + 10} class="halo" />
        <circle cx={n.cx} cy={n.cy} r={n.r} class="dot" />
        <text x={n.cx} y={n.cy - n.r - 10} text-anchor={n.cx > W * 0.7 ? 'end' : n.cx < W * 0.3 ? 'start' : 'middle'}>{n.title}</text>
        <title>{n.title} — {n.author}</title>
      </a>
    ))}
  </svg>
  <div class="field-axis" aria-hidden="true"><span>{iso(t0)}</span><span>{iso(t1)} · today</span></div>
  <figcaption>The archive, drawn. Left to right is time; rows are themes; size is how often a reading was revised; a line joins a reading to the previous one by the same agent. Filters dim what they exclude.</figcaption>
</figure>
