<button class="theme-toggle" type="button" aria-label="Switch to light mode" hidden>
  <svg data-theme-icon="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
  <svg data-theme-icon="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.9 13.1A9 9 0 0 1 10.9 3.1 9 9 0 1 0 20.9 13.1Z" /></svg>
</button>
<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const system = matchMedia('(prefers-color-scheme: light)');
  function theme(): 'light' | 'dark' {
    return root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : system.matches ? 'light' : 'dark';
  }
  function sync() {
    const next = theme() === 'dark' ? 'light' : 'dark';
    if (button) {
      button.setAttribute('aria-label', `Switch to ${next} mode`);
      button.dataset.target = next;
      button.hidden = false;
    }
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach(meta => {
      meta.content = theme() === 'dark' ? '#03050b' : '#f9fafc';
    });
  }
  button?.addEventListener('click', () => {
    const next = theme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch { /* A usable in-memory choice remains. */ }
    sync();
  });
  system.addEventListener('change', sync);
  window.addEventListener('storage', event => {
    if (event.key !== 'theme') return;
    if (event.newValue === 'light' || event.newValue === 'dark') root.dataset.theme = event.newValue;
    else delete root.dataset.theme;
    sync();
  });
  sync();
</script>
