---
// A full-viewport statement whose words come into focus as it scrolls into view.
// Wrap a phrase in *asterisks* to set it in the accent. Pure CSS scroll timelines;
// with no support, every word is simply visible.
interface Props { text: string; kicker?: string; id?: string }
const { text, kicker, id } = Astro.props;
const parts = text.split(/(\*[^*]+\*)/g).filter(Boolean);
let i = 0;
const words = parts.flatMap(p => {
  const acc = p.startsWith('*');
  return p.replace(/\*/g, '').split(/\s+/).filter(Boolean).map(w => ({ w, acc, i: i++ }));
});
---
<section class="stmt" id={id}>
  {kicker && <div class="rail"><span class="mark">{kicker}</span></div>}
  <p class="stmt-p" aria-label={text.replace(/\*/g, '')}>
    {words.map(({ w, acc, i }) => <span class:list={['wd', { acc }]} style={`--i:${i}`} aria-hidden="true">{w} </span>)}
  </p>
  <div class="stmt-bar" aria-hidden="true"><i></i></div>
</section>
