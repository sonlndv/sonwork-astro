---
// Sonar by email: one field, one promise. Addresses are stored by the Worker;
// Alfred's weekly digest goes to this list once a sender is wired.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<form class="sub" data-sub method="post" action="/api/subscribe">
  {!compact && <h4>Sonar, by email</h4>}
  <p>What Sonar found, about once a week. No spam, leave any time.</p>
  <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" aria-label="Email address" />
  <button type="submit">Subscribe</button>
  <span class="msg" aria-live="polite"></span>
  <span class="rss">Prefer a feed? <a href="/rss.xml">RSS</a></span>
</form>
<script>
  function bootSub() {
    document.querySelectorAll<HTMLFormElement>('form[data-sub]').forEach((f) => {
      if (f.dataset.booted) return; f.dataset.booted = '1';
      const msg = f.querySelector<HTMLElement>('.msg')!; const btn = f.querySelector<HTMLButtonElement>('button')!;
      f.addEventListener('submit', async (e) => {
        e.preventDefault(); msg.className = 'msg'; msg.textContent = 'Saving…'; btn.disabled = true;
        const email = (f.querySelector('input') as HTMLInputElement).value.trim();
        try {
          const r = await fetch('/api/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) });
          const j = await r.json().catch(() => ({}));
          if (r.ok) { msg.className = 'msg ok'; msg.textContent = j.already ? 'Already on the list.' : 'Kept. Sonar will write.'; f.reset(); }
          else { msg.textContent = j.error || 'Could not save.'; }
        } catch { msg.textContent = 'Could not reach the server.'; }
        btn.disabled = false;
      });
    });
  }
  document.addEventListener('astro:page-load', bootSub);
</script>
