---
// The stack, as a diagram in the site's own language: rules and mono labels.
// One person decides; three runtimes do the work; one engine, Sonar,
// researches and writes for every project. Names here are the decision of 2026-09-03
// (PRODUCT.md, AGENTS.md); change them there first.
import Bot from './Bot.astro';
import Sonar from './Sonar.astro';
---
<div class="stack" role="img" aria-label="Sơn decides. Three runtimes: Claude, the AI stack, is where Sơn builds and ships. Alfred on Grok Bot runs the teams, the research and the management. Fred on Hermes maintains the brain and the server and researches for Sonar. Sonar researches and writes for every project in the portfolio.">
  <div class="stack-src"><span>Sơn</span><em>decides</em></div>
  <ol class="stack-row">
    <li class="tile">
      <span class="rt">AI stack</span>
      <span class="mk mk-mono" aria-hidden="true">&gt;_</span>
      <b>Claude</b>
      <p>Where I work: build, deliver and ship the site, the tools and the programs.</p>
    </li>
    <li class="tile">
      <span class="rt">Grok Bot</span>
      <span class="mk"><Bot size={22} /></span>
      <b>Alfred</b>
      <p>Chief Everything Officer. Runs the teams, the research and the management.</p>
    </li>
    <li class="tile">
      <span class="rt">Hermes</span>
      <span class="mk"><Bot size={22} class="dim" /></span>
      <b>Fred</b>
      <p>Maintains the brain and the server, and researches for Sonar.</p>
    </li>
  </ol>
  <div class="stack-out"><Sonar size={16} /><span>Sonar</span><em>researches and writes · for every project in the portfolio</em></div>
</div>
