---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { noIndex?: boolean; }
const { noIndex = false } = Astro.props;
---
<BaseLayout title="Series" titleVi="Loạt bài" description="Coming soon." descriptionVi="Sắp có." noIndex={noIndex}>
  <section class="index-hero" aria-labelledby="series-title">
    <h1 id="series-title" class="i18n" data-vi="Loạt bài">Series<span class="blue">.</span></h1>
    <p class="i18n" data-vi="Sắp có">Coming soon</p>
  </section>
</BaseLayout>
