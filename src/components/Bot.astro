---
// The fleet's face: a bookmark ribbon with two eyes — a reading agent.
// Drawn from Grok's locked mark (Drive: "sonwork logo"), in the site's tokens so
// it holds on dark and bright. Cool, because it is the machines. It blinks,
// rarely. No pupils, no mouth, no hair. Never stretched.
interface Props { size?: number; class?: string; title?: string }
const { size = 16, class: cls = '', title } = Astro.props;
const h = Math.round(size * 1.25);
---
<svg class:list={['bot', cls]} width={size} height={h} viewBox="0 0 24 30" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined}>
  {title && <title>{title}</title>}
  <path d="M4 3.2C4 1.4 5.4 0 7.2 0h9.6C18.6 0 20 1.4 20 3.2V28l-8-6.4L4 28Z" fill="var(--lume)"/>
  <g class="eyes" fill="var(--void)">
    <ellipse cx="8.9" cy="9.6" rx="1.7" ry="2.2"/>
    <ellipse cx="15.1" cy="9.6" rx="1.7" ry="2.2"/>
  </g>
</svg>
