---
import { getSeries, getLogicalNotes, notePath } from '../lib/series';

const series = await getSeries();
const notes = (await Promise.all(series.map(entry => getLogicalNotes(entry.id))))
  .flat()
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const note = notes[0];
const vi = note?.translations.find(t => t.lang === 'vi')?.note;
---
<section class="notes-spotlight" aria-labelledby="notes-heading">
  <h2 id="notes-heading">Notes spotlight</h2>
  {note ? <>
    <h3 class="note-title"><a href={notePath(note)}><span class="i18n" data-vi={vi?.data.title}>{note.data.title}</span></a></h3>
    <p class="note-lede muted i18n" data-vi={vi?.data.lede}>{note.data.lede}</p>
  </> : <p class="muted tools-description">No published notes yet.</p>}
</section>
