---
import { getSeries, getNotes, notePath } from '../lib/series';

const series = await getSeries();
const notes = (await Promise.all(series.map(entry => getNotes(entry.id))))
  .flat()
  .filter(note => !note.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const note = notes[0];
---
<section class="notes-spotlight" aria-labelledby="notes-heading">
  <h2 id="notes-heading">Notes spotlight</h2>
  {note ? <>
    <h3 class="note-title"><a href={notePath(note)}>{note.data.title}</a></h3>
    <p class="note-lede muted">{note.data.lede}</p>
  </> : <p class="muted tools-description">No published notes yet.</p>}
</section>
