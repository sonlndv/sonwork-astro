---
// Site-wide landscape, rendered once by BaseLayout: owned static art, rendered as authored markup.
import scene from '../assets/mountain-scene.html?raw';

// The owned asset has independent sky, far, middle and near planes. Insert mist once at its
// explicit middle/near boundary; moving original SVG groups never changes their path data.
const anchor = '<!-- sonwork:mist-boundary -->';
if (scene.split(anchor).length !== 2) throw new Error('mountain-scene.html: mist anchor is missing or not unique');
const mist = '<div class="mtn-mist" aria-hidden="true"><i class="mtn-mist-ribbon"></i></div>';
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/(.)\/$/, '$1') || '/';
// One sky (Son-approved 2026-11-03): every route emits Home's scene (data-mode="home"). The per-route behaviour that is not
// scenery (the mist and hello answer, the Build entrance, the index-route rim draw-in, Mount) reads data-route instead.
const route = path === '/' ? 'home' : ['/work', '/writing'].includes(path) ? 'index' : 'calm';
const modeAnchor = 'data-mode="calm"';
if (scene.split(modeAnchor).length !== 2) throw new Error('mountain-scene.html: mode anchor is missing or not unique');
const emitted = scene.replace(anchor, mist).replace(modeAnchor, `data-mode="home" data-route="${route}"`);
// The baked Home sky textures (/mountains/real-*.webp, 16 image nodes) are emitted as authored on every route.
const homeTexture = 'href="/mountains/real-';
const neptuneTexture = 'href="/mountains/real-neptune';
if (scene.split(homeTexture).length !== 17) throw new Error('mountain-scene.html: expected exactly 16 Home real-body texture hrefs');
if (scene.split(neptuneTexture).length !== 5) throw new Error('mountain-scene.html: expected exactly 4 Neptune texture hrefs');
// The retired off-Home crescent raster must not come back.
if (scene.includes('blue-planet.webp')) throw new Error('mountain-scene.html: blue-planet.webp is no longer referenced by the scene');
// Fail closed on a partial migration: no retired blue-clone texture may remain anywhere in the scene.
if (scene.includes('/mountains/ow-')) throw new Error('mountain-scene.html: a retired /mountains/ow- texture is still referenced');
// The retired inert-texture attributes must not come back.
if (/data-(home|np)-src="\/mountains\/real-/.test(scene)) throw new Error('mountain-scene.html: the source carries inert texture attributes');
---
<Fragment set:html={emitted} />