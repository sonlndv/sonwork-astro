<button class="lang-toggle" type="button" aria-label="VI — switch to Vietnamese interface" hidden>VI</button>
<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.lang-toggle');
  function lang(): 'en' | 'vi' {
    return root.dataset.lang === 'vi' ? 'vi' : 'en';
  }
  // The accessible name must contain the visible label (WCAG 2.5.3 / axe
  // label-content-name-mismatch), so it leads with the same text the button shows.
  function sync() {
    const current = lang();
    const next = current === 'vi' ? 'en' : 'vi';
    if (button) {
      button.textContent = next.toUpperCase();
      button.setAttribute('aria-label', current === 'vi'
        ? 'EN — Chuyển sang tiếng Anh'
        : 'VI — switch to Vietnamese interface');
      button.dataset.target = next;
      button.hidden = false;
    }
  }
  function broadcast(next: 'en' | 'vi') {
    document.dispatchEvent(new CustomEvent('sonwork:lang', { detail: { lang: next } }));
  }
  function changeLang() {
    const next = lang() === 'vi' ? 'en' : 'vi';
    root.dataset.lang = next;
    root.lang = next;
    try { localStorage.setItem('lang', next); } catch { /* A usable in-memory choice remains. */ }
    sync();
    broadcast(next);
  }
  button?.addEventListener('click', changeLang);
  window.addEventListener('storage', event => {
    if (event.key !== 'lang') return;
    if (event.newValue === 'vi') { root.dataset.lang = 'vi'; root.lang = 'vi'; }
    else { delete root.dataset.lang; root.lang = 'en'; }
    sync();
    broadcast(lang());
  });
  sync();
</script>
