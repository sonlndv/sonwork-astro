<button class="copy-email" type="button" hidden data-copy-email="son@sonwork.org" aria-describedby="copy-email-status"><span class="i18n" data-vi="Sao chép email">Copy email</span></button>
<span id="copy-email-status" class="copy-status" role="status" aria-live="polite"></span>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('#copy-email-status');
  if (button && status) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      if (button.getAttribute('aria-busy') === 'true') return;
      button.setAttribute('aria-disabled', 'true');
      button.setAttribute('aria-busy', 'true');
      status.textContent = '';
      const vi = typeof window.sonworkLang === 'function' && window.sonworkLang() === 'vi';
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail!);
        status.textContent = vi ? 'Đã sao chép email.' : 'Email copied.';
      } catch {
        status.textContent = vi
          ? 'Không sao chép được. Hãy chọn địa chỉ hoặc mở ứng dụng email.'
          : 'Could not copy. Select the address or open your email app.';
      } finally {
        button.removeAttribute('aria-disabled');
        button.removeAttribute('aria-busy');
      }
    });
  }
</script>
