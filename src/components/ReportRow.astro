---
import type { CollectionEntry } from 'astro:content';
import { glyph, THEME_LABEL } from '../lib/glyphs';
import { runtimeOf } from '../lib/byline';
import Bot from './Bot.astro';
interface Props { entry: CollectionEntry<'reports'>; href?: string }
const { entry, href = `/readings/${entry.id}/` } = Astro.props;
const d = entry.data;
const iso = d.date.toISOString().slice(0, 10);
const idx = iso.replace(/-/g, '.');
---
<a class="r" href={href} lang={d.lang}>
  <div class="idx"><time datetime={iso}>{idx}</time><span class="kind" set:html={glyph(d.type, 12) + `<em>${THEME_LABEL[d.type]}</em>`} />{d.lang === 'vi' && <span>vi</span>}</div>
  <div>
    <h3>{d.title}</h3>
    <p>{d.dek}</p>
    <div class="meta">
      <span class="by"><Bot size={8} /> by <i>{d.author}</i> <em class="rt">on {runtimeOf(d.author)}</em></span>
      {d.revision > 1 && <><span class="sep"></span><span class="num">rev {d.revision}</span></>}
    </div>
  </div>
</a>
