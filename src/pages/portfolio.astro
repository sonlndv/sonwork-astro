---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
const label = (s: string) => s === 'active' ? 'Active' : s === 'building' ? 'Building' : s === 'parked' ? 'Parked' : 'Exploring';
---
<Base title="Portfolio — The LS15 Journal">
  <div class="wrap">
    <Nav active="" />
    <main class="page">
      <div class="page-h">
        <h1>The portfolio</h1>
        <p>A one-person holding company, run like a small portfolio: a few bets, each kept deliberately small.</p>
      </div>
      <div class="entries">
        {projects.map(p => (
          <div class="entry" style="cursor:default">
            <span class="etag">{label(p.status)}</span>
            <span class="et">{p.name}{p.url && <a href={p.url} target="_blank" rel="noopener" style="color:var(--blue-hi);font-size:.85rem;font-weight:600;margin-left:12px">Visit ↗</a>}</span>
            <span class="ex">{p.description}</span>
          </div>
        ))}
      </div>
      <Footer />
    </main>
  </div>
</Base>
