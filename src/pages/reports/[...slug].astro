---
import Base from '../../layouts/Base.astro';
import Notes from '../../components/Notes.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat(d.lang === 'vi' ? 'vi-VN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${d.title} — Sơn Lê`} description={d.dek} current="reports" lang={d.lang} wide>
  <div class="docgrid">
    <article class="doc" data-pagefind-body data-pagefind-meta={`author:${d.author}, type:${d.type}`}>
      <h1>{d.title}</h1>
      <div class="stamp">
        <span class="kind">{d.type}</span>
        <span>by <i>{d.author}</i></span>
        <time datetime={d.date.toISOString().slice(0,10)}>{fmt.format(d.date)}</time>
        <span>{d.lang === 'vi' ? 'Tiếng Việt' : 'English'}</span>
        <span class="num">Revision {d.revision}</span>
        {d.public
          ? <a class="pub" href={`/p/${entry.id}/`}>Public ↗</a>
          : <span>Private</span>}
      </div>
      <div class="prose"><Content /></div>
      {d.sources?.length ? (
        <section class="srcs">
          <div class="sh"><h2>Sources</h2></div>
          {d.sources.map(s => <a class="b" href={s}><h3>{s}</h3></a>)}
        </section>
      ) : null}
    </article>
    <Notes slug={entry.id} />
  </div>
</Base>
