---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat(d.lang === 'vi' ? 'vi-VN' : 'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${d.title} — Sơn Lê`} description={d.dek} current="reports">
  <article class="doc" style="padding:64px 0 40px" data-pagefind-body>
    <h1>{d.title}</h1>
    <div class="stamp">
      <span style="color:var(--lume)">{d.type}</span>
      <span>by <i style="font-style:normal;color:var(--ink-2)">{d.author}</i></span>
      <time datetime={d.date.toISOString().slice(0,10)}>{fmt.format(d.date)}</time>
      <span>{d.lang === 'vi' ? 'Tiếng Việt' : 'English'}</span>
      <span class="num">Revision {d.revision}</span>
      <span>{d.public ? 'Public' : 'Private'}</span>
    </div>
    <div class="prose"><Content /></div>

    {d.sources && d.sources.length > 0 && (
      <section style="padding-top:38px">
        <div class="sh"><h2>Sources</h2></div>
        {d.sources.map(s => (
          <a class="b" href={s}><h3 style="font-size:16px;word-break:break-all">{s}</h3></a>
        ))}
      </section>
    )}
  </article>
</Base>
