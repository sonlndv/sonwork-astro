---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout noIndex title="Page not found" description="This page does not exist on Sonwork.">
  <div class="not-found">
    <header class="page-head">
      <h1>Page not found</h1>
      <p>There is nothing at this address. Try one of these:</p>
    </header>
    <ol class="rows">
      <li class="row"><span class="row-index" aria-hidden="true">01</span><div class="row-body"><h2><a href="/">Home</a></h2></div></li>
      <li class="row"><span class="row-index" aria-hidden="true">02</span><div class="row-body"><h2><a href="/work">Work</a></h2></div></li>
      <li class="row"><span class="row-index" aria-hidden="true">03</span><div class="row-body"><h2><a href="/writing">Writing</a></h2></div></li>
    </ol>
  </div>
</BaseLayout>
