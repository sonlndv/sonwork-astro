---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import SideProjectItem from '../../components/SideProjectItem.astro';
import { getSideProjects, getWork } from '../../lib/content';

const work = await getWork();
const sideProjects = await getSideProjects();
const description = 'Live products Son built, with case studies, and the side projects around them.';
const descriptionVi = 'Những sản phẩm Son đã đưa vào sử dụng, bài viết về quá trình làm và các dự án nhỏ liên quan.';
---
<BaseLayout title="Build" titleVi="Dự án" description={description} descriptionVi={descriptionVi}>
  <div class="index-page">
    <header class="page-head">
      <h1 class="i18n" data-vi="Dự án">Build</h1>
      <p class="i18n" data-vi={descriptionVi}>{description}</p>
    </header>

    <section class="page-section" aria-labelledby="work-live">
      <div class="section-head">
        <h2 id="work-live" class="i18n" data-vi="Sản phẩm đang hoạt động">Live products</h2>
        <p>{work.length}</p>
      </div>
      {work.length === 0 ? (
        <p class="empty i18n" data-vi="Chưa có dự án nào được giới thiệu.">No work listed yet.</p>
      ) : (
        <ol class="rows">
          {work.map((entry, i) => <li><WorkCard entry={entry} index={i + 1} /></li>)}
        </ol>
      )}
    </section>

    <section class="page-section" aria-labelledby="work-side">
      <div class="section-head">
        <h2 id="work-side" class="i18n" data-vi="Dự án nhỏ">Side projects</h2>
        <p>{sideProjects.length}</p>
      </div>
      {sideProjects.length === 0 ? (
        <p class="empty i18n" data-vi="Chưa có dự án nhỏ nào được giới thiệu.">No side projects listed yet.</p>
      ) : (
        <ul class="side-rows">
          {sideProjects.map((entry) => <li><SideProjectItem entry={entry} /></li>)}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>
