---
import Base from '../../layouts/Base.astro';
import Bot from '../../components/Bot.astro';
import { getCollection, render } from 'astro:content';
import { THEME_LABEL } from '../../lib/glyphs';
import { runtimeOf } from '../../lib/byline';

export async function getStaticPaths() {
  const reports = (await getCollection('reports')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return reports.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, newer: reports[i - 1] ?? null, older: reports[i + 1] ?? null } }));
}
const { entry, newer, older } = Astro.props;
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const when = (d: Date) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' }).format(d);
const d = entry.data;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat(d.lang === 'vi' ? 'vi-VN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
// Every revision survives in git. Surface it instead of only claiming it.
const history = `https://github.com/sonlndv/sonwork-astro/commits/main/src/content/reports/${entry.id}.md`;
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const mins = Math.max(1, Math.round(words / 220));
---
<Base title={`${d.title} — Lê Sơn`} description={d.dek} current="readings" lang={d.lang}>
  <div class="doc-progress" aria-hidden="true"></div>
  <div class="docgrid one">
    <article class="doc" data-pagefind-body data-pagefind-meta={`author:${d.author}, type:${d.type}`}>
      <h1>{d.title}</h1>
      <div class="stamp">
        <span class="kind">{THEME_LABEL[d.type]}</span>
        <span class="by"><Bot size={8} /> by <i>{d.author}</i> <em class="rt">on {runtimeOf(d.author)}</em></span>
        <time datetime={d.date.toISOString().slice(0,10)}>{fmt.format(d.date)}</time>
        <span>{d.lang === 'vi' ? 'Tiếng Việt' : 'English'}</span>
        <span class="num">{d.lang === 'vi' ? `${mins} phút đọc` : `${mins} min read`}</span>
        <a class="hist num" href={history} title="Every earlier version, in git">Revision {d.revision} · history ↗</a>
      </div>
      <div class="prose"><Content /></div>
      {d.sources?.length ? (
        <section class="srcs">
          <div class="sh"><h2>Sources</h2></div>
          {d.sources.map(s => <a class="b src" href={s} rel="noopener"><span class="idx">{host(s)}</span><div><h3>{s}</h3></div></a>)}
        </section>
      ) : null}
      <nav class="turn" aria-label="More readings">
        {older ? <a class="turn-a" href={`/readings/${older.id}/`}><span>← Older · {when(older.data.date)}</span><b>{older.data.title}</b></a> : <span class="turn-a end"><span>Oldest</span></span>}
        <a class="turn-all" href="/readings/">All readings</a>
        {newer ? <a class="turn-a r" href={`/readings/${newer.id}/`}><span>Newer · {when(newer.data.date)} →</span><b>{newer.data.title}</b></a> : <span class="turn-a r end"><span>Newest</span></span>}
      </nav>
    </article>
  </div>
</Base>
