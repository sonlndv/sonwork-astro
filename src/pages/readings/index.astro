---
import Base from '../../layouts/Base.astro';
import ReportRow from '../../components/ReportRow.astro';
import Field from '../../components/Field.astro';
import Bot from '../../components/Bot.astro';
import { getCollection } from 'astro:content';

const reports = (await getCollection('reports'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear = new Map<number, typeof reports>();
for (const r of reports) {
  const y = r.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(r);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---
<Base title="Readings — Lê Sơn" current="readings">
  <div class="intro" style="padding:72px 0 36px">
    <h1 style="font-size:clamp(28px,3.6vw,38px);max-width:24ch">Everything written.</h1>
    <p class="last"><span id="shown">{reports.length}</span> of {reports.length} · newest first · written by AI, read by me. <kbd class="kk">⌘K</kbd> searches the full text.</p>
    <p class="gloss"><b>news</b> short market updates · <b>country</b> a country's model, focus and growth · <b>industry</b> the value chain and what matters in it · <b>company</b> a profile built around operational excellence · <b>business model</b> how a model actually works · <b>sociology</b> game theory and social behaviour, applied to business</p>
  </div>

  {reports.length > 0 && <Field reports={reports} />}
  {years.map(y => (
    <section data-year={y} class="sec">
      <header class="sec-h"><h2>{y}</h2><div class="sec-m"><span data-year-count>{byYear.get(y)!.length} filed</span></div></header>
      {byYear.get(y)!.map(entry => (
        <div data-id={entry.id} data-type={entry.data.type} data-lang={entry.data.lang}><ReportRow entry={entry} /></div>
      ))}
    </section>
  ))}
  <div id="none" hidden class="empty-bot"><Bot size={30} title="Alfred" /><p class="empty">Alfred has nothing that matches those filters.</p></div>

  <script>
  // The map is the instrument: row labels filter by theme (press again to clear),
  // the language buttons toggle, the preview line follows hover and focus, the
  // list below answers the same state. Everything works without this script:
  // nodes are links and the list is complete.
  function bootField() {
    const field = document.querySelector<HTMLElement>('.field');
    if (!field || field.dataset.booted) return; field.dataset.booted = '1';
    const state: Record<string, string> = { type: '', lang: '' };
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-id][data-type][data-lang]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-year]'));
    const shown = document.getElementById('shown')!;
    const none = document.getElementById('none')!;
    const nodes = Array.from(field.querySelectorAll<HTMLElement>('.node'));
    const links = Array.from(field.querySelectorAll<SVGElement>('.link'));
    const buttons = Array.from(field.querySelectorAll<HTMLButtonElement>('button[data-f]'));
    const pv = document.getElementById('field-pv')!;
    const nodeFits = (n: HTMLElement) => (!state.type || n.dataset.type === state.type) && (!state.lang || (n.dataset.langs || '').split(' ').includes(state.lang));
    const rowFits = (r: HTMLElement) => (!state.type || r.dataset.type === state.type) && (!state.lang || r.dataset.lang === state.lang);
    const nodeOf = (id: string) => nodes.find(n => (n.dataset.ids || '').split(' ').includes(id));
    const rowsOf = (n: HTMLElement) => (n.dataset.ids || '').split(' ').map(id => rows.find(r => r.dataset.id === id)).filter(Boolean) as HTMLElement[];
    // preview: the line under the map shows the hovered or focused node
    const preview = (n: HTMLElement) => { const t = field.querySelector<HTMLElement>(`.field-pvs [data-for="${CSS.escape(n.dataset.key!)}"]`); if (t) pv.innerHTML = t.innerHTML; };
    nodes.forEach(n => {
      const on = () => { preview(n); rowsOf(n).forEach(r => r.classList.add('hot')); };
      const off = () => rowsOf(n).forEach(r => r.classList.remove('hot'));
      n.addEventListener('pointerenter', on); n.addEventListener('focus', on);
      n.addEventListener('pointerleave', off); n.addEventListener('blur', off);
    });
    rows.forEach(r => {
      r.addEventListener('pointerenter', () => { const n = nodeOf(r.dataset.id!); if (n) { n.classList.add('hot'); preview(n); } });
      r.addEventListener('pointerleave', () => nodeOf(r.dataset.id!)?.classList.remove('hot'));
    });
    function apply() {
      nodes.forEach(n => n.classList.toggle('off', !nodeFits(n)));
      const lit = new Set(nodes.filter(nodeFits).map(n => n.dataset.i));
      links.forEach(l => l.classList.toggle('off', !(lit.has(l.dataset.a) && lit.has(l.dataset.b))));
      let count = 0;
      for (const r of rows) { const ok = rowFits(r); r.hidden = !ok; if (ok) count++; }
      for (const s of sections) {
        const k = s.querySelectorAll<HTMLElement>('[data-type]:not([hidden])').length;
        s.hidden = k === 0;
        s.querySelector('[data-year-count]')!.textContent = `${k} filed`;
      }
      shown.textContent = String(count); none.hidden = count > 0;
      buttons.forEach(b => b.setAttribute('aria-pressed', String(state[b.dataset.f!] === b.dataset.v)));
      const q = new URLSearchParams(); if (state.type) q.set('type', state.type); if (state.lang) q.set('lang', state.lang);
      history.replaceState(null, '', q.toString() ? '?' + q : location.pathname);
    }
    buttons.forEach(b => b.addEventListener('click', () => { const f = b.dataset.f!, v = b.dataset.v!; state[f] = state[f] === v ? '' : v; apply(); }));
    const init = new URLSearchParams(location.search);
    let fromUrl = false;
    for (const f of ['type', 'lang']) { const v = init.get(f) || ''; if (v && buttons.some(b => b.dataset.f === f && b.dataset.v === v)) { state[f] = v; fromUrl = true; } }
    if (fromUrl) apply();
  }
  document.addEventListener('astro:page-load', bootField);
  </script>
</Base>
