---
import Base from '../../layouts/Base.astro';
import ReportRow from '../../components/ReportRow.astro';
import Field from '../../components/Field.astro';
import { getCollection } from 'astro:content';

const reports = (await getCollection('reports'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear = new Map<number, typeof reports>();
for (const r of reports) {
  const y = r.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(r);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const types = ['news', 'breakdown', 'research', 'model', 'analysis', 'technical'] as const;
const count = (k: string, v: string) => reports.filter(r => (r.data as any)[k] === v).length;
---
<Base title="Research — Sơn Lê" current="readings">
  <div class="intro" style="padding:72px 0 36px">
    <h1 style="font-size:clamp(28px,3.6vw,38px);max-width:24ch">The readings, all of them.</h1>
    <p class="last"><span id="shown">{reports.length}</span> of {reports.length}, newest first, filed by my research agents. <kbd class="kk">⌘K</kbd> searches the full text.</p>
    <p class="gloss"><b>news</b> what happened · <b>breakdown</b> one story taken apart · <b>research</b> business and market research · <b>model</b> numbers and scenarios · <b>analysis</b> a longer argument · <b>technical</b> engineering writeups</p>
  </div>

  <div class="filters" role="group" aria-label="Filter readings">
    <div class="fgroup">
      <button type="button" data-f="type" data-v="" aria-pressed="true">All types</button>
      {types.filter(t => count('type', t) > 0).map(t => <button type="button" data-f="type" data-v={t} aria-pressed="false">{t} <span>{count('type', t)}</span></button>)}
    </div>
    <div class="fgroup">
      <button type="button" data-f="lang" data-v="" aria-pressed="true">Both languages</button>
      {count('lang','en') > 0 && <button type="button" data-f="lang" data-v="en" aria-pressed="false">English <span>{count('lang','en')}</span></button>}
      {count('lang','vi') > 0 && <button type="button" data-f="lang" data-v="vi" aria-pressed="false">Tiếng Việt <span>{count('lang','vi')}</span></button>}
    </div>
  </div>

  {years.length === 0 && <p style="color:var(--ink-3)">Nothing filed yet.</p>}
  {years.map(y => (
    <section data-year={y}>
      <div class="sh"><h2>{y}</h2><span data-year-count>{byYear.get(y)!.length} filed</span></div>
      {byYear.get(y)!.map(entry => (
        <div data-type={entry.data.type} data-lang={entry.data.lang}><ReportRow entry={entry} /></div>
      ))}
    </section>
  ))}
  <p id="none" hidden style="color:var(--ink-3)">Nothing matches those filters.</p>

  <script>
  function bootFilters() {
    if (!document.querySelector('.filters') || (document.querySelector('.filters') as HTMLElement).dataset.booted) return;
    (document.querySelector('.filters') as HTMLElement).dataset.booted = '1';
    const state: Record<string, string> = { type: '', lang: '' };
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-type][data-lang]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-year]'));
    const shown = document.getElementById('shown')!;
    const none = document.getElementById('none')!;
    function apply() {
      let n = 0;
      document.querySelectorAll<HTMLElement>('.field .node').forEach(n => { n.hidden = !((!state.type || n.dataset.type === state.type) && (!state.lang || n.dataset.lang === state.lang)); });
      for (const r of rows) {
        const ok = (!state.type || r.dataset.type === state.type) && (!state.lang || r.dataset.lang === state.lang);
        r.hidden = !ok; if (ok) n++;
      }
      for (const s of sections) {
        const k = s.querySelectorAll<HTMLElement>('[data-type]:not([hidden])').length;
        s.hidden = k === 0;
        s.querySelector('[data-year-count]')!.textContent = `${k} filed`;
      }
      shown.textContent = String(n); none.hidden = n > 0;
      const q = new URLSearchParams(); if (state.type) q.set('type', state.type); if (state.lang) q.set('lang', state.lang);
      history.replaceState(null, '', q.toString() ? '?' + q : location.pathname);
    }
    document.querySelectorAll<HTMLButtonElement>('.filters button').forEach(b => b.addEventListener('click', () => {
      const f = b.dataset.f!; state[f] = b.dataset.v!;
      document.querySelectorAll<HTMLButtonElement>(`.filters button[data-f="${f}"]`).forEach(x => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    const init = new URLSearchParams(location.search);
    for (const f of ['type', 'lang']) { const v = init.get(f) || ''; const b = document.querySelector<HTMLButtonElement>(`.filters button[data-f="${f}"][data-v="${v}"]`); if (b && v) b.click(); }
  }
  document.addEventListener('astro:page-load', bootFilters);
  </script>
</Base>
