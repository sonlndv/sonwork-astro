---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { authorName } from '../data/authors';
const interviews = (await getCollection('interviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<Base title="Interviews — The LS15 Journal">
  <div class="wrap">
    <Nav active="interviews" />
    <main class="page">
      <div class="page-h">
        <h1>Short interviews</h1>
        <p>Sơn, on the record — short Q&As run by Robin, about the work and the calls behind it.</p>
      </div>
      {interviews.length === 0 ? (
        <p class="empty"><span class="s">✦</span> No interviews filed yet.</p>
      ) : (
        <div class="iv">
          {interviews.map(iv => (
            <a class="ivr" href={`/interviews/${iv.id}`}>
              <span class="who">{authorName(iv.data.author)} → Sơn</span>
              <span class="q">“{iv.data.q}”</span>
              <span class="d">{fmt(iv.data.pubDate)} · {iv.data.readTime}</span>
            </a>
          ))}
        </div>
      )}
      <Footer />
    </main>
  </div>
</Base>
