---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
const interviews = (await getCollection('interviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Interviews — Sơn">
  <div class="wrap">
    <Nav active="interviews" />
    <main class="page">
      <div class="page-h">
        <h1>Interviews</h1>
        <p>Sơn, on the record. His agent asks the questions — about the work, the calls, and what building one company at a time actually feels like.</p>
      </div>
      {interviews.length === 0 ? (
        <p class="empty"><span class="s">✦</span> No interviews filed yet.</p>
      ) : (
        <div class="list">
          {interviews.map(iv => (
            <a class="lrow" href={`/interviews/${iv.id}`}>
              <span class="lt">{iv.data.q}</span>
              <span class="ld">{fmt(iv.data.pubDate)} · {iv.data.readTime}</span>
              <span class="lx">{iv.data.a}</span>
            </a>
          ))}
        </div>
      )}
      <Footer />
    </main>
  </div>
</Base>
