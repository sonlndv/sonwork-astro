---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProseLayout from '../layouts/ProseLayout.astro';
import { isVisible } from '../lib/content';

const about = await getEntry('pages', 'about');
const shown = about && isVisible(about) ? about : undefined;
const Content = shown ? (await render(shown)).Content : undefined;
---
{shown && Content ? (
  <ProseLayout title={shown.data.title} description={shown.data.description} draft={shown.data.draft} type="website">
    <Content />
  </ProseLayout>
) : (
  <BaseLayout title="About" description="About Son, with contact links.">
    <h1>About</h1>
    <p class="empty">This page is not published yet.</p>
  </BaseLayout>
)}
