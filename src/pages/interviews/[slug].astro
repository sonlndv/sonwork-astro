---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const ivs = await getCollection('interviews', ({ data }) => !data.draft);
  return ivs.map(iv => ({ params: { slug: iv.id }, props: { iv } }));
}
const { iv } = Astro.props;
const { Content } = await render(iv);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title={`${iv.data.title} — Interview`} description={iv.data.q}>
  <div class="wrap"><Nav active="interviews" /></div>
  <article class="article">
    <a class="back" href="/interviews">← Interviews</a>
    <span class="series-tag">Interview · Agent → Sơn</span>
    <h1>{iv.data.title}</h1>
    <div class="byl"><span>{fmt(iv.data.pubDate)}</span><span>·</span><span>{iv.data.readTime}</span></div>
    <div class="rule"></div>
    <div class="body"><Content /></div>
    <div class="snav" style="grid-template-columns:1fr"><a href="/interviews"><div class="l">← Back</div><div class="t">All interviews</div></a></div>
    <Footer />
  </article>
</Base>
