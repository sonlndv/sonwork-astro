---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { series } from '../../data/series';
export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) => !data.draft);
  return series.map(s => {
    const items = entries
      .filter(e => e.data.series === s.slug)
      .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
    return { params: { slug: s.slug }, props: { s, items } };
  });
}
const { s, items } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<Base title={`${s.name} — Series`} description={s.description}>
  <div class="wrap">
    <Nav active="series" />
    <main class="page">
      <a class="back" href="/series">← All series</a>
      <div class="page-h" style="margin-top:24px">
        <span class="tag">Series</span>
        <h1>{s.name}</h1>
        <p>{s.description}</p>
      </div>
      {items.length === 0 ? (
        <p class="empty"><span class="s">✦</span> No entries in this series yet.</p>
      ) : (
        <div class="entries">
          {items.map((e, i) => (
            <a class="entry" href={`/posts/${e.id}`}>
              <span class="etag">Part {i + 1} of {items.length}</span>
              <span class="et">{e.data.title}</span>
              {e.data.description && <span class="ex">{e.data.description}</span>}
              <span class="ed">{fmt(e.data.pubDate)} · {e.data.readTime}</span>
            </a>
          ))}
        </div>
      )}
      <Footer />
    </main>
  </div>
</Base>
