---
import Base from '../../layouts/Base.astro';
import Bot from '../../components/Bot.astro';
import Found from '../../components/Found.astro';
import Sonar from '../../components/Sonar.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getCollection, render } from 'astro:content';
import { latestDay } from '../../lib/found';
import { runtimeOf } from '../../lib/byline';
import { THEMES } from '../../content.config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const reports = entry.id === 'sonar' ? (await getCollection('reports')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) : [];
const day = latestDay(reports);
const journal = (await getCollection('journal')).filter(j => j.data.project === entry.id).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const rendered = await Promise.all(journal.map(async j => ({ j, C: (await render(j)).Content })));
const fmt = (x: Date) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(x);
---
<Base title={`${d.title} — Lê Sơn`} description={d.summary} current="projects">
  <article class="doc" style="padding:64px 0 20px">
    <div class="stamp" style="border:0;margin-bottom:10px;padding:0"><span class="num">{String(d.order).padStart(2,'0')}</span><span class="port-status"><i></i>{d.status}</span>{d.started && <span>since {fmt(d.started)}</span>}</div>
    <h1>{entry.id === 'sonar' && <Sonar size={44} class="inl" title="Sonar" />}{d.title}{d.tagline && <span class="tag"> {d.tagline}</span>}</h1>
    <p class="open-p" style="margin-bottom:34px">{d.summary}</p>
    <div class="prose"><Content /></div>
  </article>

  {entry.id === 'sonar' && (
    <section class="sec" id="found">
      <header class="sec-h"><h2><Sonar size={30} class="inl" />What Sonar <span>found.</span></h2><div class="sec-m"><span>{day.date ? `${day.day.replace(/-/g, '.')} · ${day.items.length} of ${THEMES.length} themes` : 'nothing filed yet'}</span><a href="/readings/">All {reports.length} readings →</a></div></header>
      <Found reports={day.items} id="found-sonar" />
      <Subscribe />
    </section>
  )}

  <section class="sec" id="diary">
    <header class="sec-h"><h2>Build <span>diary.</span></h2><div class="sec-m"><span>{journal.length} {journal.length === 1 ? 'entry' : 'entries'}</span></div></header>
    {journal.length === 0 && <div class="empty-bot"><Bot size={30} /><p class="empty">Nothing written yet.</p></div>}
    {rendered.map(({ j, C }) => (
      <article class="diary">
        <div class="idx"><time datetime={j.data.date.toISOString().slice(0,10)}>{j.data.date.toISOString().slice(0,10).replace(/-/g,'.')}</time><span class="by"><Bot size={8} /> <i>{j.data.author}</i> <em class="rt">on {runtimeOf(j.data.author)}</em></span></div>
        <div><h3>{j.data.title}</h3><div class="prose small"><C /></div></div>
      </article>
    ))}
  </section>
</Base>
