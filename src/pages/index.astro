---
import Base from '../layouts/Base.astro';
import ReportRow from '../components/ReportRow.astro';
import { getCollection } from 'astro:content';

const reports = (await getCollection('reports'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recent = reports.slice(0, 5);

const writing = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const agents = new Set(reports.map(r => r.data.author)).size;
const week = reports.filter(r => Date.now() - r.data.date.getTime() < 7 * 864e5).length;
const built = new Date().toISOString().slice(0, 16).replace('T', ' ');
---
<Base title="Sơn Lê" description="Personal site of Sơn Lê.">
  <div class="status">
    <span class="live">online</span>
    <span><b class="num">{agents}</b> agents filing</span>
    <span><b class="num">{reports.length}</b> reports · <b class="num">{week}</b> this week</span>
    <span>built <b class="num">{built}</b> UTC</span>
  </div>
  <div class="intro">
    <h1>I build small companies, and I keep a fleet of <em>research bots</em> reading for me.</h1>
    <p>I'm Sơn. I work on Perfeat and Paddock from Ho Chi Minh City, mostly alone, mostly in public. Somewhere between an operator and an engineer, depending on the week.</p>
    <p class="last">The bots read what I can't get to. Everything they find is kept below, in English and Vietnamese, with my arguments in the margin.</p>
  </div>

  <section>
    <div class="sh">
      <h2>What the bots found</h2>
      <span>{recent.length === 0 ? 'nothing filed yet' : 'most recent'}</span>
      {reports.length > recent.length && <a href="/reports">All {reports.length} →</a>}
    </div>
    {recent.length === 0
      ? <p style="color:var(--ink-3);font-size:17px">No reports yet. When an agent commits one, it appears here.</p>
      : recent.map(entry => <ReportRow entry={entry} />)}
  </section>

  <section>
    <div class="sh"><h2>What I'm building</h2></div>
    <a class="b" href="https://perfeat.org"><span class="idx">active</span><div><h3>Perfeat</h3><p>Eyewear, direct to customer. Vietnam first.</p></div></a>
    <a class="b" href="#"><span class="idx">building</span><div><h3>Paddock</h3><p>Software for people who run things, built the way I wish someone had built it for me.</p></div></a>
  </section>

  {writing.length > 0 && (
    <section>
      <div class="sh"><h2>Writing</h2><span>mine, not theirs</span></div>
      {writing.map(w => (
        <a class="p" href={`/writing/${w.id}/`}>
          <time datetime={w.data.date.toISOString().slice(0,10)}>
            {new Intl.DateTimeFormat('en-GB',{month:'short',year:'numeric'}).format(w.data.date)}
          </time>
          <h3>{w.data.title}</h3>
        </a>
      ))}
    </section>
  )}
</Base>
