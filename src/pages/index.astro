---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';

const allPosts = (await getCollection('posts', ({data}) => !data.draft))
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const activeProjects = projects.filter(p => p.status === 'active' || p.status === 'building');

const totalReadTime = allPosts.reduce((acc, p) => acc + parseInt(p.data.readTime), 0);
---
<Base>
  <Nav active="dashboard" />

  <main class="home">

    <!-- WHO -->
    <section class="hero">
      <div class="hero-left">
        <p class="hero-kick">Solo founder · Saigon · 2026</p>
        <h1 class="hero-name">Sơn</h1>
        <p class="hero-role">Builder of <b>companies</b>, one&nbsp;person&nbsp;deep</p>
        <p class="hero-lead">
          A one-person holding company — the ventures, the systems, and the
          field notes, shipped in the open.
        </p>
        <div class="hero-ctas">
          <a href="/projects" class="btn-primary">See the work</a>
          <a href="/writing" class="btn-ghost">Field log</a>
        </div>
      </div>
      <div class="hero-stage" aria-hidden="true">
        <span class="hero-stage-label">Portrait / Visual</span>
        <div class="hero-figure"></div>
        {activeProjects.length > 0 && (
          <div class="hero-ticket">
            <div class="ticket-hd"><span>Now building</span><span class="ticket-dot"></span></div>
            {activeProjects.slice(0,3).map(p => (
              <div class="ticket-row">
                <span class="ticket-name">{p.name}</span>
                <span class="ticket-status">{p.status}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- WHAT I'M BUILDING -->
    {activeProjects.length > 0 && (
      <section class="home-section">
        <div class="section-hd">
          <h2 class="section-title">Building</h2>
          <a href="/projects" class="section-all">all projects →</a>
        </div>
        <div class="fp-cards">
          {activeProjects.map(p => (
            <a href="/projects" class:list={['fp-card', `fp-${p.slug}`]}>
              <div class="fp-card-accent"></div>
              <div class="fp-card-body">
                <div class="fp-card-top">
                  <span class="fp-card-emoji">{p.emoji}</span>
                  <span class:list={['fp-card-badge', `fp-badge-${p.status}`]}>{p.status}</span>
                </div>
                <div class="fp-card-name">{p.name}</div>
                <div class="fp-card-tag">{p.tagline}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- WRITING -->
    <section class="home-section">
      <div class="section-hd">
        <h2 class="section-title">Writing</h2>
        {allPosts.length > 0 && <a href="/writing" class="section-all">all →</a>}
      </div>

      {allPosts.length === 0 ? (
        <div class="journal-empty">
          <p class="journal-empty-lead">The first page is still blank.</p>
          <p class="journal-empty-sub">
            I'm writing as I build. The opening pieces go up here soon: notes on
            shipping in Saigon, on what a year of building actually teaches you,
            on the people I keep learning from.
          </p>
          <div class="journal-rules" aria-hidden="true"></div>
        </div>
      ) : (
        <div class="post-feed">
          {allPosts.map(post => (
            <a href={`/posts/${post.id}`} class="post-row">
              <span class="post-title">{post.data.title}</span>
              <span class="post-date text-3">
                {post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}
              </span>
            </a>
          ))}
        </div>
      )}
    </section>

  </main>
</Base>
