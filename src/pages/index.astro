---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolStrip from '../components/ToolStrip.astro';
import GithubCalendar from '../components/GithubCalendar.astro';
import NotesSpotlight from '../components/NotesSpotlight.astro';
---
<BaseLayout title="Son." description="I’m Son, a business guy in Vietnam, trying things with AI and sharing what I learn through notes and visual explanations." descriptionVi="Mình là Son, làm trong lĩnh vực kinh doanh tại Việt Nam, đang thử nghiệm cùng AI và chia sẻ điều học được qua ghi chú và giải thích trực quan.">
  <section class="about-opening" aria-labelledby="home-title">
    <h1 id="home-title"><span class="ink-line i18n" data-vi="Thử nghiệm">Trying things</span> <span class="ink-line i18n" data-vi="cùng AI.">with AI.</span><br class="ink-title-break" /><span class="ink-accent blue"><span class="ink-line i18n" data-vi="Vừa làm,">Learning</span> <span class="ink-line"><span class="ink-underline i18n" data-vi="vừa học.">as I go.</span></span></span></h1>
    <p class="home-intro i18n" data-vi="Mình là Son, làm trong lĩnh vực kinh doanh tại Việt Nam. Mình đang tìm hiểu cách dùng AI để tự động hoá công việc và làm ra những thứ hữu ích.">I’m Son, a business guy in Vietnam, exploring how AI can help me automate work and build useful things.</p>
    <p class="muted intro-secondary i18n" data-vi="Mình thử các ý tưởng cùng trợ lý AI lập trình rồi ghi lại điều gì hiệu quả, điều gì chưa ổn, kèm cách giải thích trực quan và ví dụ nhỏ.">I test ideas with coding agents and keep notes on what works and what doesn’t, with visual explanations and small examples.</p>
    <nav class="about-contacts" aria-label="Contact Son" data-i18n-attr="aria-label" data-vi-aria-label="Liên hệ với Son">
      <ul>
        <li><a href="mailto:son@sonwork.org">son@sonwork.org</a></li>
        <li><a href="https://x.com/sonldv">X @sonldv</a></li>
        <li><a href="https://github.com/sonlndv">GitHub sonlndv</a></li>
        <li><a href="https://www.linkedin.com/in/sonle2003/">LinkedIn in/sonle2003</a></li>
      </ul>
    </nav>
  </section>
  <div class="about-tools"><ToolStrip /><GithubCalendar /><NotesSpotlight /></div>
</BaseLayout>
<script>
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const sections = [...document.querySelectorAll<HTMLElement>('.tools-section, .github-calendar, .notes-spotlight')];
  for (const section of sections) {
    const trace = document.createElement('span');
    trace.className = 'editorial-rule-trace';
    trace.setAttribute('aria-hidden', 'true');
    section.append(trace);
  }
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        entry.target.classList.add('rule-seen');
        observer.unobserve(entry.target);
      }
    }
  }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
  function syncRules() {
    observer.disconnect();
    for (const section of sections) {
      section.classList.remove('rule-seen');
      if (!preference.matches) observer.observe(section);
    }
  }
  preference.addEventListener('change', syncRules);
  syncRules();
</script>
