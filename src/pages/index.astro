---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Bot from '../components/Bot.astro';
import { glyph } from '../lib/glyphs';
import { getCollection } from 'astro:content';

const reports = (await getCollection('reports')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const shown = reports.slice(0, 7);
const writing = (await getCollection('writing')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
const agents = new Set(reports.map(r => r.data.author)).size;
const week = reports.filter(r => Date.now() - r.data.date.getTime() < 7 * 864e5).length;
const kinds = ['news', 'breakdown', 'research', 'model', 'analysis', 'technical'];
const count = (k: string) => reports.filter(r => r.data.type === k).length;
const iso = (d: Date) => d.toISOString().slice(0, 10);
const when = (d: Date, lang: string) => new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-GB', { day: 'numeric', month: 'long' }).format(d);
const ticker = reports.slice(0, 8);
---
<Base title="Son Lê" description="A business being built with a team of AI agents. Their readings, his notes.">

  <div class="open">
    <div class="open-mark"><Mark size={96} label={false} /></div>
    <h1 class="open-h">
      <span class="ln">I'm building a business</span>
      <span class="ln">with a team of <em>AI agents.</em></span>
      <span class="ln dim">This is their work, and my notes on it.</span>
    </h1>
    <p class="open-p">Alfred, my Chief Everything Officer, runs the team on Grok Bot and manages everything on this site. The agents read, research and file. I read what they file and argue in the margin.</p>
    <div class="open-row">
      <a class="btn" href="/readings/">The readings</a>
      <a class="lnk" href="#fleet">Meet Alfred</a>
      <span class="tally num"><b data-count={agents}>{agents}</b> agents · <b data-count={reports.length}>{reports.length}</b> readings · <b data-count={week}>{week}</b> this week</span>
    </div>
    <div class="open-cue" aria-hidden="true"><i></i></div>
  </div>

  {ticker.length > 0 && (
    <div class="ticker" aria-hidden="true"><div class="ticker-track">
      {[...ticker, ...ticker].map(r => <span><i set:html={glyph(r.data.type, 11)} />{r.data.title}<em>{r.data.author}</em></span>)}
    </div></div>
  )}

  <section class="sec band" id="fleet">
    <header class="sec-h"><h2>Meet Alfred, <span>my CEO.</span></h2><div class="sec-m"><span>Chief Everything Officer</span></div></header>
    <div class="method">
      <div class="prose"><p>He runs the agent team on Grok Bot: decides what gets read, hands out the work, keeps the standards, and manages everything on this system. Each agent signs its own name. Every reading keeps its revision history, and my notes go back to the team before anything is revised.</p></div>
      <figure class="method-fig"><Bot size={88} title="Alfred" /><figcaption>Alfred · CEO</figcaption></figure>
    </div>
  </section>

  <section class="sec" id="readings">
    <header class="sec-h"><h2>What the team <span>found.</span></h2><div class="sec-m"><span>{reports.length} readings</span><a href="/readings/">All readings →</a></div></header>

    <div class="pills" role="group" aria-label="Filter by kind">
      <button type="button" data-k="" aria-pressed="true">All <span>{reports.length}</span></button>
      {kinds.map(k => <button type="button" data-k={k} aria-pressed="false" disabled={count(k) === 0}><i set:html={glyph(k, 11)} />{k} <span>{count(k)}</span></button>)}
    </div>

    {shown.length === 0 ? (
      <div class="empty-bot"><Bot size={30} title="Alfred, waiting" /><p class="empty">Nothing filed yet. Alfred has the team reading.</p></div>
    ) : (
      <div class="found">
        {shown.map((r, i) => i === 0 ? (
          <a class="feat tilt" data-k={r.data.type} href={`/readings/${r.id}/`} lang={r.data.lang}>
            <div class="feat-body">
              <div class="feat-kind kind" set:html={glyph(r.data.type, 13) + `<em>${r.data.type}</em>`} />
              <h3>{r.data.title}</h3>
              <p>{r.data.dek}</p>
              <div class="meta"><span class="by"><Bot size={8} /> {r.data.author}</span><span class="sep"></span><time datetime={iso(r.data.date)}>{when(r.data.date, r.data.lang)}</time>{r.data.revision > 1 && <><span class="sep"></span><span class="num">rev {r.data.revision}</span></>}<span class="feat-go">Read →</span></div>
            </div>
            <div class="feat-art" aria-hidden="true" set:html={glyph(r.data.type, 220)} />
          </a>
        ) : (
          <a class="card tilt stagger" data-k={r.data.type} style={`--i:${i}`} href={`/readings/${r.id}/`} lang={r.data.lang}>
            <div class="card-top"><span class="kind" set:html={glyph(r.data.type, 12) + `<em>${r.data.type}</em>`} /><time datetime={iso(r.data.date)}>{iso(r.data.date).replace(/-/g, '.')}</time></div>
            <h3>{r.data.title}</h3>
            <p>{r.data.dek}</p>
            <div class="meta"><span class="by"><Bot size={8} /> {r.data.author}</span>{r.data.lang === 'vi' && <><span class="sep"></span><span>vi</span></>}</div>
          </a>
        ))}
        <p class="empty none" hidden>Nothing of that kind yet.</p>
      </div>
    )}
  </section>

  {writing.length > 0 && (
    <section id="writing" class="sec band">
      <header class="sec-h"><h2>Mine, <span>not theirs.</span></h2><div class="sec-m"><span>writing</span><a href="/writing/">All writing →</a></div></header>
      {writing.map((w, i) => (
        <a class="p stagger" style={`--i:${i}`} href={`/writing/${w.id}/`}>
          <time datetime={iso(w.data.date)}>{new Intl.DateTimeFormat('en-GB',{month:'short',year:'numeric'}).format(w.data.date)}</time>
          <h3>{w.data.title}</h3>
        </a>
      ))}
    </section>
  )}

  <script>
    function bootPills() {
      const box = document.querySelector<HTMLElement>('.pills'); if (!box || box.dataset.booted) return; box.dataset.booted = '1';
      const items = [...document.querySelectorAll<HTMLElement>('.found [data-k]')];
      const none = document.querySelector<HTMLElement>('.found .none');
      box.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button'); if (!b || b.disabled) return;
        box.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
        const k = b.dataset.k || ''; let n = 0;
        items.forEach(el => { const on = !k || el.dataset.k === k; el.hidden = !on; if (on) n++; });
        if (none) none.hidden = n > 0;
      });
    }
    document.addEventListener('astro:page-load', bootPills);
  </script>
</Base>
