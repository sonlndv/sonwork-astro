---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Bot from '../components/Bot.astro';
import Stack from '../components/Stack.astro';
import Run from '../components/Run.astro';
import Sonar from '../components/Sonar.astro';
import Subscribe from '../components/Subscribe.astro';
import { glyph } from '../lib/glyphs';
import { latestDay } from '../lib/found';
import { THEMES } from '../content.config';
import { getCollection } from 'astro:content';

const reports = (await getCollection('reports')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
// The home shows one day of research: the newest day, one reading per theme.
const day = latestDay(reports);
// the pipeline's real numbers on the portfolio card
const sources = reports.reduce((n, r) => n + (r.data.sources?.length ?? 0), 0);
const revisions = reports.reduce((n, r) => n + (r.data.revision ?? 1), 0);
const agents = new Set(reports.map(r => r.data.author)).size;
const iso = (d: Date) => d.toISOString().slice(0, 10);
const week = reports.filter(r => Date.now() - r.data.date.getTime() < 7 * 864e5).length;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const ticker = reports.slice(0, 8);
// each project discloses its latest thing: its newest diary post, or for Sonar the newest reading if newer
const journal = (await getCollection('journal')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestOf = (id: string) => {
  const j = journal.find(x => x.data.project === id);
  const c: { date: Date; title: string; href: string; kind: string }[] = [];
  if (j) c.push({ date: j.data.date, title: j.data.title, href: `/diary/${j.id}/`, kind: 'diary' });
  if (id === 'sonar' && reports[0]) c.push({ date: reports[0].data.date, title: reports[0].data.title, href: `/readings/${reports[0].id}/`, kind: 'reading' });
  return c.sort((a, b) => b.date.getTime() - a.date.getTime())[0] ?? null;
};
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const dayDiary = journal.find(j => j.data.project === 'sonar' && iso(j.data.date) === day.day) ?? null;
---
<Base title="Lê Sơn" description="One person, a team of AI agents, building a business. Three runtimes: Claude is where Sơn builds, Alfred runs the teams on Grok Bot, Fred maintains the brain and the server on Hermes. Sonar, the engine, researches and writes for every project.">

  <div class="open">
    <div class="open-body">
      <div class="open-mark appear" style="--d:.06s"><Mark size={64} label={false} /></div>
      <div class="badge appear appear--pop" style="--d:.22s"><Sonar size={13} />Live · AI writes, I read</div>
      <h1 class="open-h">
        <span class="line"><span class="ln appear appear--mask" style="--d:.42s">One person,</span></span>
        <span class="line"><span class="ln appear appear--mask" style="--d:.56s">a team of <em>AI agents,</em></span></span>
        <span class="line"><span class="ln dim appear appear--mask" style="--d:.70s">building a business.</span></span>
      </h1>
      <ul class="open-list appear appear--soft" style="--d:.86s;--dur:1.25s">
        <li>AI agents research and write. I decide what, and I read the result.</li>
        <li>Everything they write is published here. Every revision is kept.</li>
        <li>Two projects: Sonar, the research engine. Lever, an operations practice.</li>
      </ul>
      <div class="open-row">
        <a class="btn appear appear--btn" style="--d:1s" href="#portfolio">What I'm building</a>
        <a class="lnk appear appear--side" style="--d:1.12s" href="#stack">Who does what</a>
      </div>
    </div>
    <div class="open-stats">
      <span class="stat appear appear--stat" style="--d:1.2s"><i class="stat-ico"><Bot size={9} /></i><b class="num" data-count={agents}>{agents}</b> {agents === 1 ? 'AI writer' : 'AI writers'}</span>
      <span class="stat appear appear--stat" style="--d:1.34s"><i class="stat-ico"><Sonar size={16} /></i><b class="num" data-count={reports.length}>{reports.length}</b> readings published</span>
      <span class="stat appear appear--stat" style="--d:1.48s"><i class="stat-ico" set:html={glyph('news', 16)} /><b class="num" data-count={week}>{week}</b> this week</span>
    </div>
  </div>

  {ticker.length > 0 && (
    <div class="ticker" aria-hidden="true"><div class="ticker-track">
      {[...ticker, ...ticker].map(r => <span><i set:html={glyph(r.data.type, 11)} />{r.data.title}<em>{r.data.author}</em></span>)}
    </div></div>
  )}

  <section class="sec" id="stack">
    <header class="sec-h"><h2>Who does <span>what.</span></h2><div class="sec-m"><span>I decide · three AIs work · one engine writes</span></div></header>
    <Stack />
  </section>

  <section class="sec" id="portfolio">
    <header class="sec-h"><h2>What I'm <span>building.</span></h2><div class="sec-m"><span>{projects.filter(p => p.data.status === 'live').length} live · {projects.length} projects</span><a href="/projects/">All projects →</a></div></header>
    <div class="port">
      {projects.map(p => (
        <a class:list={['port-item', { tilt: p.data.status === 'live', 'port-next': p.data.status !== 'live' }]} href={`/projects/${p.id}/`}>
          <div class="port-top"><span class="mono">{String(p.data.order).padStart(2,'0')}{p.data.url && <> · {host(p.data.url)} ↗</>}</span><span class:list={['port-status', { dim: p.data.status !== 'live' }]}>{p.data.status === 'live' && <i></i>}{p.data.status}</span></div>
          <h3>{p.id === 'sonar' && <Sonar size={26} class="inl" />}{p.data.title}{p.data.tagline && <small> · {p.data.tagline}</small>}</h3>
          <p>{p.data.summary}</p>
          {(() => { const l = latestOf(p.id); return l && <div class="port-latest"><span>latest · {iso(l.date).replace(/-/g, '.')} · {l.kind}</span><b>{l.title}</b></div>; })()}
          {p.data.status === 'live' && (
            <div class="steps">
              <div class="step"><b>Find</b><p>Pick what is worth understanding.</p><span class="step-live">{THEMES.length} themes</span></div>
              <div class="step"><b>Research</b><p>Read the sources. Check the numbers.</p><span class="step-live">{sources} sources cited</span></div>
              <div class="step"><b>Publish</b><p>Write it up here. Keep every revision.</p><span class="step-live">{reports.length} readings · {revisions} revisions</span></div>
            </div>
          )}
          <span class="port-go">Profile and build diary →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="sec" id="readings">
    <header class="sec-h"><h2><Sonar size={30} class="inl" />What Sonar <span>found.</span></h2><div class="sec-m"><span>{day.date ? `newest day · ${day.day.replace(/-/g, '.')} · ${day.items.length} of ${THEMES.length} themes` : 'the research engine'}</span><a href="/readings/">All {reports.length} readings →</a></div></header>
    <Run stations={day.stations} items={day.items} day={day.day.replace(/-/g, '.')} diary={dayDiary ? { id: dayDiary.id, title: dayDiary.data.title } : null} id="run-home" />
    <Subscribe />
  </section>


</Base>
