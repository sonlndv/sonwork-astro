---
import Base from '../layouts/Base.astro';
import ReportRow from '../components/ReportRow.astro';
import Field from '../components/Field.astro';
import Statement from '../components/Statement.astro';
import { getCollection } from 'astro:content';

const reports = (await getCollection('reports')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recent = reports.slice(0, 5);
const writing = (await getCollection('writing')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
const agents = new Set(reports.map(r => r.data.author)).size;
const week = reports.filter(r => Date.now() - r.data.date.getTime() < 7 * 864e5).length;
const built = new Date().toISOString().slice(0, 16).replace('T', ' ');
---
<Base title="Sơn Lê" description="Sơn Lê builds small companies and keeps a fleet of research bots reading for him. Their readings, his notes.">
  <div class="status">
    <span class="live">online</span>
    <span><b class="num" data-count={agents}>{agents}</b> agents filing</span>
    <span><b class="num" data-count={reports.length}>{reports.length}</b> readings · <b class="num" data-count={week}>{week}</b> this week</span>
    <span>built <b class="num">{built}</b> UTC</span>
  </div>

  <div class="intro hero">
    <div class="loc"><span class="dotc"></span>SƠN LÊ <em>/</em> HỒ CHÍ MINH CITY <em>/</em> <span class="num">{built.slice(0,10)}</span></div>
    <h1>
      <span class="ln wd">I build small companies,</span>
      <span class="ln dim wd">and I keep a fleet of</span>
      <span class="ln wd"><em>research bots</em> reading for me.</span>
    </h1>
    <p class="wd">I'm Sơn. Perfeat and Paddock, from Ho Chi Minh City, mostly alone, mostly in public. Somewhere between an operator and an engineer, depending on the week.</p>
    <div class="cta wd"><a class="btn" href="#readings">Read what they found</a><a class="lnk" href="/about/">About me</a></div>
    <div class="scrollhint" aria-hidden="true">scroll<i></i></div>
  </div>

  <Statement kicker="01 — the idea"
    text="The bots read what I can't get to: news, breakdowns, business research, models. Everything they find is kept here, in English and Vietnamese, *with my notes in the margin.* The machines write. I argue." />

  <Field reports={reports} />

  <section id="readings" class="chapter">
    <div class="rail"><span class="mark">02 — the readings</span></div>
    <h2 class="big">Everything my machines read, kept.</h2>
    <div class="sh">
      <h2>Most recent</h2>
      <span>{recent.length === 0 ? 'nothing filed yet' : `${recent.length} of ${reports.length}`}</span>
      {reports.length > 0 && <a href="/reports/">All {reports.length} →</a>}
    </div>
    {recent.length === 0
      ? <p style="color:var(--ink-3);font-weight:300">No readings yet. When an agent commits one, it appears here.</p>
      : recent.map(entry => <ReportRow entry={entry} />)}
  </section>

  <section class="chapter">
    <div class="rail"><span class="mark">03 — building</span></div>
    <h2 class="big dim">Two companies, <span>one person, a lot of machines.</span></h2>
    <div class="sh"><h2>Now</h2></div>
    <a class="b" href="https://perfeat.org"><span class="idx">active</span><div><h3>Perfeat</h3><p>Eyewear, direct to customer. Vietnam first.</p></div></a>
    <a class="b" href="#"><span class="idx">building</span><div><h3>Paddock</h3><p>Software for people who run things, built the way I wish someone had built it for me.</p></div></a>
  </section>

  {writing.length > 0 && (
    <section id="writing" class="chapter">
      <div class="rail"><span class="mark">04 — writing</span></div>
      <h2 class="big">Mine, <span>not theirs.</span></h2>
      <div class="sh"><h2>Recent</h2></div>
      {writing.map(w => (
        <a class="p" href={`/writing/${w.id}/`}>
          <time datetime={w.data.date.toISOString().slice(0,10)}>{new Intl.DateTimeFormat('en-GB',{month:'short',year:'numeric'}).format(w.data.date)}</time>
          <h3>{w.data.title}</h3>
        </a>
      ))}
    </section>
  )}

  <section id="contact" class="chapter">
    <div class="rail"><span class="mark">05 — contact</span></div>
    <h2 class="big">I read everything, <span>slowly.</span></h2>
    <div class="sh"><h2>Reach me</h2></div>
    <div class="contact">
      <a href="mailto:son@perfeat.org"><span class="idx">work</span><b>son@perfeat.org</b><i>→</i></a>
      <a href="mailto:tuanson.le03@gmail.com"><span class="idx">personal</span><b>tuanson.le03@gmail.com</b><i>→</i></a>
      <a href="https://www.linkedin.com/in/toilaleson" rel="me"><span class="idx">linkedin</span><b>in/toilaleson</b><i>↗</i></a>
    </div>
  </section>
</Base>
