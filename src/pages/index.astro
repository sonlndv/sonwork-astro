---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import SideProjectItem from '../components/SideProjectItem.astro';
import CopyEmail from '../components/CopyEmail.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { getSideProjects, getWork, isVisible } from '../lib/content';

const about = await getEntry('pages', 'about');
const copy = about && isVisible(about) ? about.data : undefined;
const intro = copy?.homeIntro;
const work = await getWork();
const sideProjects = await getSideProjects();
const contact = [
  { label: 'Email', value: 'son@sonwork.org', href: 'mailto:son@sonwork.org' },
  { label: 'X', value: '@sonldv', href: 'https://x.com/sonldv' },
  { label: 'GitHub', value: 'sonlndv', href: 'https://github.com/sonlndv' },
  { label: 'LinkedIn', value: 'in/sonle2003', href: 'https://www.linkedin.com/in/sonle2003' },
];
---
<BaseLayout title="Sonwork" description={copy?.description ?? 'Software, writing and a newsletter from Son.'}>
  <div class="front">
    <section class="front-lead front-about" aria-labelledby="home-title">
      <h1 id="home-title">{copy?.homeTitle ?? 'About'}</h1>
      {intro && <p class="home-intro">{intro}</p>}
      {copy?.homeBuild && <details class="home-build">
        <summary>What I'm exploring</summary>
        <p>{copy.homeBuild}</p>
      </details>}
      <a class="home-more" href="/about">Full About and contributions</a>
    </section>

    <div class="front-main">
      <section class="front-projects" aria-labelledby="home-projects">
        <div class="section-head">
          <h2 id="home-projects">Selected projects</h2>
          <a href="/work">All work</a>
        </div>
        <ol class="rows">
          {work.map((entry, i) => <li><WorkCard entry={entry} headingLevel={3} index={i + 1} /></li>)}
        </ol>
        <ul class="side-rows">
          {sideProjects.map((entry) => <li><SideProjectItem entry={entry} compact /></li>)}
        </ul>
      </section>

      <section class="front-contact" aria-labelledby="home-contact">
        <div class="section-head">
          <h2 id="home-contact">Contact</h2>
        </div>
        <dl class="facts">
          {contact.map((link) => <div>
            <dt>{link.label}</dt>
            <dd><a href={link.href}>{link.value}</a>{link.label === 'Email' && <CopyEmail />}</dd>
          </div>)}
        </dl>
      </section>
      <section class="front-newsletter" aria-labelledby="home-newsletter">
        <div class="section-head"><h2 id="home-newsletter">Newsletter</h2></div>
        <SubscribeForm id="home-subscribe" />
      </section>
    </div>
  </div>
</BaseLayout>
