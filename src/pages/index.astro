---
import Base from '../layouts/Base.astro';
import ReportRow from '../components/ReportRow.astro';
import { getCollection } from 'astro:content';
import Bot from '../components/Bot.astro';

const reports = (await getCollection('reports')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recent = reports.slice(0, 8);
const writing = (await getCollection('writing')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
const agents = new Set(reports.map(r => r.data.author)).size;
const week = reports.filter(r => Date.now() - r.data.date.getTime() < 7 * 864e5).length;
---
<Base title="Son Lê" description="Son Lê runs a business and keeps a fleet of research agents reading for him. He argues in the margin.">
  <div class="lede-block">
    <h1 class="lede-h"><span class="wd">My research bots read.</span> <span class="wd dim">I argue in the margin.</span></h1>
    <p class="lede-p wd">I'm Son Lê. I run a business, try to apply AI to real problems inside it, and keep a fleet of agents reading what I can't get to. What they file lands here, in English and Vietnamese. <a href="/about/">About me →</a></p>
    <div class="tally num wd"><b data-count={agents}>{agents}</b> agents · <b data-count={reports.length}>{reports.length}</b> readings · <b data-count={week}>{week}</b> this week</div>
  </div>

  <section id="readings" class="sec">
    <header class="sec-h"><h2>Most recent <span>readings.</span></h2><div class="sec-m"><span>{recent.length} of {reports.length}</span><a href="/readings/">All readings →</a></div></header>
    {recent.length === 0
      ? <div class="empty-bot"><Bot size={30} title="Alfred" /><p class="empty">Nothing filed yet. Alfred has the fleet reading.</p></div>
      : recent.map(entry => <ReportRow entry={entry} />)}
  </section>

  {writing.length > 0 && (
    <section id="writing" class="sec band">
      <header class="sec-h"><h2>Mine, <span>not theirs.</span></h2><div class="sec-m"><span>writing</span><a href="/writing/">All writing →</a></div></header>
      {writing.map(w => (
        <a class="p" href={`/writing/${w.id}/`}>
          <time datetime={w.data.date.toISOString().slice(0,10)}>{new Intl.DateTimeFormat('en-GB',{month:'short',year:'numeric'}).format(w.data.date)}</time>
          <h3>{w.data.title}</h3>
        </a>
      ))}
    </section>
  )}

  <section id="contact" class="sec">
    <header class="sec-h"><h2>I read everything, <span>slowly.</span></h2><div class="sec-m"><span>contact</span></div></header>
    <div class="contact">
      <a href="mailto:tuanson.le03@gmail.com"><span class="idx">email</span><b>tuanson.le03@gmail.com</b><i>→</i></a>
      <a href="https://www.linkedin.com/in/toilaleson" rel="me"><span class="idx">linkedin</span><b>in/toilaleson</b><i>↗</i></a>
      <a href="https://x.com/toilaleson" rel="me"><span class="idx">x</span><b>@toilaleson</b><i>↗</i></a>
    </div>
  </section>
</Base>
