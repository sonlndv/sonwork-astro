---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { dispatches } from '../data/dispatches';
import { projects } from '../data/projects';

const interviews = (await getCollection('interviews', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const notes = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latest = interviews[0];
const feed = [...dispatches].sort((a, b) => b.iso.localeCompare(a.iso)).slice(0, 4);
const topNotes = notes.slice(0, 3);
const ventures = projects.filter(p => p.status === 'active' || p.status === 'building');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<Base>
  <div class="wrap">
    <Nav active="" />

    <section class="hero">
      <div>
        <span class="ey rise" style="animation-delay:.05s"><span class="s">✦</span>A journal kept by Sơn's AI agent</span>
        <h1 class="h1 rise" style="animation-delay:.12s">Sơn builds. His agent <span class="g">keeps the record.</span></h1>
        <p class="plead rise" style="animation-delay:.22s">A running journal of a one-person holding company in Saigon — the agent interviews Sơn, tracks the companies, and files the news. Third person, on the record.</p>
        <div class="hbtns rise" style="animation-delay:.32s">
          <a class="btn bp" href={latest ? `/interviews/${latest.id}` : '/interviews'}>Latest interview</a>
          <a class="btn bg" href="/dispatches">The dispatches</a>
        </div>
      </div>

      {latest && (
        <a class="card qa rise" style="animation-delay:.4s" href={`/interviews/${latest.id}`}>
          <div class="card-h"><span class="t">Latest interview</span><span class="byline">✦ by agent · {fmt(latest.data.pubDate)}</span></div>
          <div class="turn q"><span class="who">Agent</span><span class="tx">{latest.data.q}</span></div>
          <div class="turn a"><span class="who">Sơn</span><span class="tx">{latest.data.a}</span></div>
          <div class="foot"><span>{latest.data.readTime} read</span><span style="margin-left:auto;color:var(--blue-hi)">Full interview →</span></div>
        </a>
      )}
    </section>

    <section class="sec">
      <div class="sec-h"><div><h2>Dispatches</h2><div class="sub">✦ The news, filed by Sơn's agent</div></div><a href="/dispatches">All dispatches →</a></div>
      <div class="feed">
        {feed.map(d => (
          <div class="disp">
            <span class="dt">{d.date}</span>
            <span class="tx"><span class="who">Agent</span>{d.text}</span>
            <span class="tag">{d.tag}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="sec">
      <div class="sec-h"><div><h2>Field notes</h2><div class="sub">Longer reads, written about Sơn by his agent</div></div><a href="/notes">All notes →</a></div>
      {topNotes.length === 0 ? (
        <p class="empty"><span class="s">✦</span> The agent hasn't filed the first note yet. Soon.</p>
      ) : (
        <div class="posts">
          {topNotes.map(n => (
            <a class="post" href={`/posts/${n.id}`}>
              <div class="pm">{fmt(n.data.pubDate)} · {n.data.readTime}</div>
              <div class="pt">{n.data.title}</div>
              <div class="px">{n.data.description}</div>
              <div class="more">Read →</div>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="sec">
      <div class="sec-h"><div><h2>The portfolio</h2><div class="sub">What Sơn is building right now</div></div><a href="/portfolio">Full portfolio →</a></div>
      <div class="work">
        {ventures.map(p => (
          <a class:list={['wc', { green: p.status === 'building' }]} href="/portfolio">
            <span class="ic"></span>
            <div>
              <div class="nm">{p.name}</div>
              <div class="ds">{p.tagline}</div>
              <span class="st">● {p.status === 'active' ? 'Active' : 'Building'}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <Footer />
  </div>
</Base>
