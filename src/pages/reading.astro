---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { books } from '../data/books';
const nowReading = books.filter(b => b.status === 'reading');
const read = books.filter(b => b.status === 'read');
---
<Base title="Reading — The LS15 Journal" description="Books on Sơn's shelf — currently reading and recently finished.">
  <div class="wrap">
    <Nav active="reading" />
    <main class="page">
      <div class="page-h">
        <h1>Reading</h1>
        <p>What's on Sơn's shelf — currently reading and recently finished, kept by Robin on the personal desk.</p>
      </div>

      {nowReading.length > 0 && (
        <section class="sec" style="padding-top:0">
          <div class="sec-h"><h2>Reading now</h2></div>
          <div class="books">
            {nowReading.map(b => (
              <div class="bk">
                <span><span class="bt">{b.title}</span><span class="ba">{b.author}</span></span>
                <span class="bs now"><span class="d"></span>Reading</span>
                {b.note && <span class="bn">{b.note}</span>}
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="sec">
        <div class="sec-h"><h2>Recently read</h2></div>
        <div class="books">
          {read.map(b => (
            <div class="bk">
              <span><span class="bt">{b.title}</span><span class="ba">{b.author}</span></span>
              <span class="bs">{b.date}</span>
              {b.note && <span class="bn">{b.note}</span>}
            </div>
          ))}
        </div>
      </section>

      <Footer />
    </main>
  </div>
</Base>
