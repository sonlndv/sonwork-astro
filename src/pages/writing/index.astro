---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Writing — Sơn Lê" current="writing">
  <div class="intro" style="padding:72px 0 44px">
    <h1 style="font-size:clamp(28px,3.6vw,38px);max-width:24ch">Writing.</h1>
    <p class="last">Mine, not theirs.</p>
  </div>
  <section>
    {posts.length === 0 && <p style="color:var(--ink-3)">Nothing here yet.</p>}
    {posts.map(w => (
      <a class="p" href={`/writing/${w.id}/`}>
        <time datetime={w.data.date.toISOString().slice(0,10)}>
          {new Intl.DateTimeFormat('en-GB',{month:'short',year:'numeric'}).format(w.data.date)}
        </time>
        <h3>{w.data.title}</h3>
      </a>
    ))}
  </section>
</Base>
