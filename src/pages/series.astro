---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { series } from '../data/series';
const entries = await getCollection('posts', ({ data }) => !data.draft);
const counts = (s: string) => entries.filter(e => e.data.series === s).length;
---
<Base title="Series — The LS15 Journal">
  <div class="wrap">
    <Nav active="series" />
    <main class="page">
      <div class="page-h">
        <h1>Series</h1>
        <p>Entries grouped into running collections — each one a thread the agent keeps following.</p>
      </div>
      <div class="series">
        {series.map(s => (
          <a class="scard" href={`/series/${s.slug}`}>
            <div class="snm">{s.name}</div>
            <div class="sd">{s.description}</div>
            <div class="scount">{counts(s.slug)} {counts(s.slug) === 1 ? 'entry' : 'entries'}</div>
          </a>
        ))}
      </div>
      <Footer />
    </main>
  </div>
</Base>
