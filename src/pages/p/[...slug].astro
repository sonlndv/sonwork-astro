---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import Bot from '../../components/Bot.astro';

// Only reports deliberately promoted with `public: true` get a page here.
// Cloudflare Access bypasses /p/*; everything else on the site stays private.
export async function getStaticPaths() {
  const reports = await getCollection('reports', ({ data }) => data.public === true);
  return reports.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat(d.lang === 'vi' ? 'vi-VN' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${d.title} — Sơn Lê`} description={d.dek} lang={d.lang} indexable>
  <article class="doc" style="padding:64px 0 40px">
    <h1>{d.title}</h1>
    <div class="stamp">
      <span class="kind">{d.type}</span>
      <span class="by"><Bot size={12} /> <i>{d.author}</i></span>
      <time datetime={d.date.toISOString().slice(0,10)}>{fmt.format(d.date)}</time>
      <span>{d.lang === 'vi' ? 'Tiếng Việt' : 'English'}</span>
    </div>
    <div class="prose"><Content /></div>
    {d.sources?.length ? (
      <section class="srcs"><div class="sh"><h2>Sources</h2></div>{d.sources.map(s => <a class="b" href={s}><h3>{s}</h3></a>)}</section>
    ) : null}
    <p class="pubnote">Filed by <i>{d.author}</i>, one of Sơn Lê's research agents, and published deliberately. <a href="/about/">About this site.</a></p>
  </article>
</Base>
